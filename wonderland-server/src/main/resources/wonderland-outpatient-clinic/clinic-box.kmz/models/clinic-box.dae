<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!--
  wonderland-outpatient-clinic: the single parametric volume every cell reuses.
  A unit box (1 m on a side, base at y=0, centred on x/z). Each world cell
  places it with its own <scale>/<translation> in the position-component, so
  the floor is the box flattened to 24x0.05x18, an exam room is the box scaled
  to a 4x3x4 shell, the reception desk a small block, the directory sign a
  thin tall panel. One geometry, many roles — the 2006 worlds worked the same
  way. Clean-room authored; no binaries from the retired installer.
-->
<COLLADA xmlns="http://www.collada.org/2005/11/COLLADASchema" version="1.4.1">
  <asset>
    <contributor>
      <authoring_tool>wonderland-outpatient-clinic clean-room generator</authoring_tool>
    </contributor>
    <created>2026-10-13T00:00:00Z</created>
    <modified>2026-10-13T00:00:00Z</modified>
    <unit meter="1.0" name="meter"/>
    <up_axis>Y_UP</up_axis>
  </asset>
  <library_geometries>
    <geometry id="clinic-box-geom" name="clinic-box">
      <mesh>
        <source id="clinic-box-positions">
          <float_array id="clinic-box-positions-array" count="24">-0.5 0.0 -0.5 0.5 0.0 -0.5 0.5 1.0 -0.5 -0.5 1.0 -0.5 -0.5 0.0 0.5 0.5 0.0 0.5 0.5 1.0 0.5 -0.5 1.0 0.5</float_array>
          <technique_common>
            <accessor count="8" source="#clinic-box-positions-array" stride="3">
              <param name="X" type="float"/>
              <param name="Y" type="float"/>
              <param name="Z" type="float"/>
            </accessor>
          </technique_common>
        </source>
        <vertices id="clinic-box-vertices">
          <input semantic="POSITION" source="#clinic-box-positions"/>
        </vertices>
        <triangles count="12">
          <input semantic="POSITION" source="#clinic-box-positions" offset="0"/>
          <p>4 5 6 4 6 7 1 0 3 1 3 2 5 1 2 5 2 6 0 4 7 0 7 3 3 7 6 3 6 2 0 1 5 0 5 4</p>
        </triangles>
      </mesh>
    </geometry>
  </library_geometries>
  <library_visual_scenes>
    <visual_scene id="clinic-box-scene" name="clinic-box">
      <node id="clinic-box-node" name="clinic-box">
        <instance_geometry url="#clinic-box-geom"/>
      </node>
    </visual_scene>
  </library_visual_scenes>
  <scene>
    <instance_visual_scene url="#clinic-box-scene"/>
  </scene>
</COLLADA>
