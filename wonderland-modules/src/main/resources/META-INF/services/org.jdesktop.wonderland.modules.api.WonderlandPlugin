# wonderland-modules M4: the feature modules discovered by WonderlandPluginLoader.
# One line per WonderlandPlugin provider. Keep this list and the shipped plugins
# in step; the ShippedModuleSetTest loads it through ServiceLoader and asserts
# every module initialises in a dependency-safe order.
org.jdesktop.wonderland.modules.chat.ChatPlugin
org.jdesktop.wonderland.modules.imageviewer.ImageViewerPlugin
org.jdesktop.wonderland.modules.userlist.UserListPlugin
org.jdesktop.wonderland.modules.stickynote.StickyNotePlugin
org.jdesktop.wonderland.modules.whiteboard.WhiteboardPlugin
# M7a: the videoplayer module (OpenJFX Media replacement for the dead JMF one);
# its transport runs on the shipped no-op surface until the 2D desktop installs
# the JavaFX factory, so headless discovery behaves exactly like the M4 five.
org.jdesktop.wonderland.modules.videoplayer.VideoPlayerPlugin
# M7b: the pdfviewer module (Apache PDFBox replacement for the dead jpedal one);
# its model runs on the shipped no-op rasteriser until the desktop installs the
# PDFBox factory, so headless discovery behaves exactly like the M4 five.
org.jdesktop.wonderland.modules.pdfviewer.PdfViewerPlugin
