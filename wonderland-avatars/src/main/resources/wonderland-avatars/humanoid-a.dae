<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!--
  wonderland-avatars M6b: the default humanoid body.

  A single hand-authored axis-aligned box (0.4 x 1.7 x 0.25 m, feet at y=0)
  standing in for the real artist-supplied CC0 avatar content. The bytes are
  placeholder; the AvatarPool catalog is the code contract. Once a proper
  rigged body is authored the .dae is replaced under the same filename, and
  the pool's names and wla:// URL shape stay identical.

  The mesh is a bare POSITION + triangles geometry: no normals, no texcoords,
  no material library, so the M6b renderer's TextureBindingPlan falls back to
  the neutral grey diffuse, and AvatarRenderer's state-driven trigger colour
  is what the in-JVM probe actually sees (idle grey -> pressed yellow).
-->
<COLLADA xmlns="http://www.collada.org/2005/11/COLLADASchema" version="1.4.1">
  <asset>
    <contributor>
      <authoring_tool>wonderland-avatars placeholder generator</authoring_tool>
    </contributor>
    <created>2026-10-13T00:00:00Z</created>
    <modified>2026-10-13T00:00:00Z</modified>
    <unit meter="1.0" name="meter"/>
    <up_axis>Y_UP</up_axis>
  </asset>
  <library_geometries>
    <geometry id="humanoid-a-geom" name="humanoid-a">
      <mesh>
        <source id="humanoid-a-positions">
          <float_array id="humanoid-a-positions-array" count="24">-0.2 0.0 -0.125 0.2 0.0 -0.125 0.2 1.7 -0.125 -0.2 1.7 -0.125 -0.2 0.0 0.125 0.2 0.0 0.125 0.2 1.7 0.125 -0.2 1.7 0.125</float_array>
          <technique_common>
            <accessor count="8" source="#humanoid-a-positions-array" stride="3">
              <param name="X" type="float"/>
              <param name="Y" type="float"/>
              <param name="Z" type="float"/>
            </accessor>
          </technique_common>
        </source>
        <vertices id="humanoid-a-vertices">
          <input semantic="POSITION" source="#humanoid-a-positions"/>
        </vertices>
        <triangles count="12">
          <input semantic="POSITION" source="#humanoid-a-positions" offset="0"/>
          <p>4 5 6 4 6 7 1 0 3 1 3 2 5 1 2 5 2 6 0 4 7 0 7 3 3 7 6 3 6 2 0 1 5 0 5 4</p>
        </triangles>
      </mesh>
    </geometry>
  </library_geometries>
  <!--
    wonderland-avatars M7c: the animation catalog for body A. This is the
    COLLADA replacement for the unrecoverable jME-1.x .jme Animator clips: a
    <library_animations> block the wonderland-renderer keyframe animator
    parses and plays. "walking" bobs the body (translation.Y, stride-1
    output) and tilts it (rotation, stride-4 axis+angle bundle with the four
    .X/.Y/.Z/.ANGLE channels every 1.4.1 exporter emits); "idle" is the slow
    breathing bob. Bodies B and C deliberately ship NO animations - they
    exercise the SyntheticClips fallback path the renderer uses for any
    document without a rig. A real artist body replaces this block, not the
    filename or the pool catalog.
  -->
  <library_animations>
    <animation id="humanoid-a-walk" name="walking">
      <source id="walk-times">
        <float_array id="walk-times-array" count="3">0 0.5 1.0</float_array>
        <technique_common>
          <accessor source="#walk-times-array" count="3" stride="1">
            <param name="INPUT" type="float"/>
          </accessor>
        </technique_common>
      </source>
      <source id="walk-bob">
        <float_array id="walk-bob-array" count="3">0 0.06 0</float_array>
        <technique_common>
          <accessor source="#walk-bob-array" count="3" stride="1">
            <param name="OUTPUT" type="float"/>
          </accessor>
        </technique_common>
      </source>
      <source id="walk-sway">
        <float_array id="walk-sway-array" count="12">0 0 1 0.05 0 0 1 -0.05 0 0 1 0.05</float_array>
        <technique_common>
          <accessor source="#walk-sway-array" count="3" stride="4">
            <param name="OUTPUT" type="float"/>
          </accessor>
        </technique_common>
      </source>
      <sampler id="walk-bob-sampler" interpolation="LINEAR">
        <input semantic="INPUT" source="#walk-times" offset="0"/>
        <input semantic="OUTPUT" source="#walk-bob" offset="1"/>
        <technique_common>
          <common_accessor>
            <index>0 0 1 1 2 2</index>
          </common_accessor>
        </technique_common>
      </sampler>
      <sampler id="walk-sway-sampler" interpolation="LINEAR">
        <input semantic="INPUT" source="#walk-times" offset="0"/>
        <input semantic="OUTPUT" source="#walk-sway" offset="1"/>
        <technique_common>
          <common_accessor>
            <index>0 0 1 1 2 2</index>
          </common_accessor>
        </technique_common>
      </sampler>
      <channel source="#walk-bob-sampler" target="humanoid-a-node/translation.Y"/>
      <channel source="#walk-sway-sampler" target="humanoid-a-node/rotation.X"/>
      <channel source="#walk-sway-sampler" target="humanoid-a-node/rotation.Y"/>
      <channel source="#walk-sway-sampler" target="humanoid-a-node/rotation.Z"/>
      <channel source="#walk-sway-sampler" target="humanoid-a-node/rotation.ANGLE"/>
    </animation>
    <animation id="humanoid-a-idle" name="idle">
      <source id="idle-times">
        <float_array id="idle-times-array" count="3">0 2 4</float_array>
        <technique_common>
          <accessor source="#idle-times-array" count="3" stride="1">
            <param name="INPUT" type="float"/>
          </accessor>
        </technique_common>
      </source>
      <source id="idle-bob">
        <float_array id="idle-bob-array" count="3">0 0.02 0</float_array>
        <technique_common>
          <accessor source="#idle-bob-array" count="3" stride="1">
            <param name="OUTPUT" type="float"/>
          </accessor>
        </technique_common>
      </source>
      <sampler id="idle-bob-sampler" interpolation="LINEAR">
        <input semantic="INPUT" source="#idle-times" offset="0"/>
        <input semantic="OUTPUT" source="#idle-bob" offset="1"/>
        <technique_common>
          <common_accessor>
            <index>0 0 1 1 2 2</index>
          </common_accessor>
        </technique_common>
      </sampler>
      <channel source="#idle-bob-sampler" target="humanoid-a-node/translation.Y"/>
    </animation>
  </library_animations>
  <library_visual_scenes>
    <visual_scene id="humanoid-a-scene" name="humanoid-a">
      <node id="humanoid-a-node" name="humanoid-a">
        <instance_geometry url="#humanoid-a-geom"/>
      </node>
    </visual_scene>
  </library_visual_scenes>
  <scene>
    <instance_visual_scene url="#humanoid-a-scene"/>
  </scene>
</COLLADA>
