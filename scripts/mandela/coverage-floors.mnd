#!/usr/bin/env mandela
// coverage-floors.mnd — a coverage exemption must describe a real test suite.
//
// The root build.gradle keeps a per-module maximum achievable ratio in the
// coverageExemptions map, and `check` depends on jacocoTestCoverageVerification
// for every module that has a test suite. A module with a suite and no entry in
// the map is held to 100%. The map is therefore load-bearing in two directions
// nothing else checks: a module with a suite and no floor has no measurable
// regression guard, and an exemption for a module with no suite can never fire,
// so it advertises protection that does not exist.
//
// The third direction is the one that used to be invisible. A module with NO
// test source gets no rule at all -- the test task is NO-SOURCE, no .exec is
// written, and jacocoTestCoverageVerification is skipped -- so it is not "held to
// 100%", it is held to nothing. That is a real hole, and a document that says
// "100% coverage is mandatory" without naming it is a claim about the build that
// the build does not support. NO_SUITE below is the written acknowledgement: a
// module with no suite must appear in it, and a module that leaves it by gaining
// a suite must be deleted from it. Naming the hole is not the fix; it is what
// stops the hole from being reported as coverage.
//
//     java -jar lg3d-mandela/build-gradle/libs/lg3d-mandela-1.1.0.jar \
//         run scripts/mandela/coverage-floors.mnd -s .
//
// Gate, exit 2 on a finding. Every exemption must name a module with a suite
// and a reason in the exemptionReasons map. A module with a suite and no
// exemption is held to 100% (no finding for that — the build enforces it).

use std.fs

let ROOT = "build.gradle"
let SETTINGS = "settings.gradle"
let AGENTS = "AGENTS.md"

// module -> why it has a test suite but is exempted from 100%. A stale entry
// (the module gained 100%, left settings.gradle, or has no suite after all)
// is itself a finding.
var EXEMPT = {}
EXEMPT.put("lg3d-apps", "its panels are probe-verified against a live desktop, so a 100% floor would only price the headless fraction (AGENTS.md, Test coverage)")
EXEMPT.put("lg3d-core", "scene graph needs live 3D desktop; displayserver.crash is at 92%/82%")
EXEMPT.put("lg3d-widgets", "Swing card presentation layer needs a live desktop")
EXEMPT.put("lg3d-incubator", "only Java-3D-free Swing panels exercised; ~184k-line 3D app tree untested")
EXEMPT.put("lpm-console", "logic classes ~100%; 853-line Swing panel is probe-verified only")
EXEMPT.put("update-manager", "Swing UI + download layers need a live desktop")
EXEMPT.put("db-manager", "Swing UI is construction/probe-tested")
EXEMPT.put("ftp-client", "Swing UI is construction/probe-tested")
EXEMPT.put("lg3d-webserver", "residue is defensive branches wanting fault injection")
EXEMPT.put("lg3d-mandela", "language toolchain goal is 100%/0 mutants; floor raised as each package closes")
EXEMPT.put("wonderland-common", "untested data-model periphery pulled in by later milestones")
EXEMPT.put("wonderland-server", "defensive transport branches want fault injection")
EXEMPT.put("wonderland-modules", "defensive branches unreachable in-JVM")
EXEMPT.put("wonderland-renderer", "probe-only Java 3D assembly + GL passes cannot be constructed headless")

// module -> the fact that it has no test source at all, so no coverage rule and
// no PIT task can be applied to it. Every module with zero files under
// src/test/java must appear here, and every entry must still be true: an entry
// whose module has since grown a suite is a finding, because the module is now
// gated and the acknowledgement is stale. This list is the only place in the
// repository that states, in code, which modules the 100% rule does NOT reach.
var NO_SUITE = {}
// 247 files under gnu/ (a pure-Java X11 protocol library whose source set is
// `srcDirs = [projectDir]` + `include 'gnu/**/*.java'`, so it has no src/main/java
// either). It is the foundation of the X11 compositor, and nothing tests it.
NO_SUITE.put("lg3d-escher", "no src/test/java exists in the module; it compiles gnu/** (an X11 protocol library) and is exercised only by running the desktop, so neither jacocoTestCoverageVerification nor pitest is applied to it at all")
// 19 files under src/main/java and no test tree: see the note in
// lg3d-terminal/build.gradle, which is why that module carries no rule rather
// than a floor it could never fire.
NO_SUITE.put("lg3d-terminal", "no src/test/java exists in the module, so its test task is NO-SOURCE, no JaCoCo .exec is written, and a violation rule here would be decoration rather than a gate")

// How many .java files a directory holds, walking it by hand. A module whose
// src/test/java exists but is empty has NO suite: Gradle calls that task
// NO-SOURCE and JaCoCo never runs, so counting the directory would be a lie.
fun countJava(dir) {
    var count = 0
    if (!fs.isDirectory(dir)) { return 0 }
    var stack = [dir]
    while (stack.length > 0) {
        let at = stack.pop()
        for (name in fs.list(at)) {
            let child = "${at}/${name}"
            if (fs.isDirectory(child)) {
                stack.push(child)
            } else if (name.endsWith(".java")) {
                count += 1
            }
        }
    }
    return count
}

// The quoted value after a marker on a line, or "" — the same hand scan the
// other checkers use, because the language has no regex.
fun quotedAfter(text, marker) {
    let at = text.indexOf(marker)
    if (at < 0) { return "" }
    let rest = text.substring(at + marker.length)
    let open = rest.indexOf("'")
    if (open < 0) { return "" }
    let body = rest.substring(open + 1)
    let close = body.indexOf("'")
    if (close < 0) { return "" }
    return body.substring(0, close)
}

// The literal digits after `key:` in one entry line, or "" when they are not
// there. Kept as text, not as a Double, because the report has to show the
// number exactly as the build writes it: 0.310 and 0.31 are the same ratio and
// a different claim about precision.
fun digitsAfter(line, key) {
    let at = line.indexOf(key)
    if (at < 0) { return "" }
    var i = at + key.length
    while (i < line.length) {
        let c = line.charAt(i)
        if (c == " " or c == "\t") { i += 1 } else { break }
    }
    var digits = ""
    while (i < line.length) {
        let c = line.charAt(i)
        if (c == "." or (c >= "0" and c <= "9")) {
            digits += c
            i += 1
        } else {
            break
        }
    }
    return digits
}

// The map's own text, from its opening bracket to the line that closes it.
fun exemptionsBlock(text) {
    let at = text.indexOf("coverageExemptions = [")
    if (at < 0) { error("${ROOT} has no coverageExemptions map", "ViolationError") }
    let rest = text.substring(at)
    let end = rest.indexOf("\n    ]")
    if (end < 0) { error("the coverageExemptions map is never closed", "ViolationError") }
    return rest.substring(0, end)
}

var modules = []
for (line in fs.lines(SETTINGS)) {
    if (!line.trim().startsWith("include ")) { continue }
    let name = quotedAfter(line, "include ")
    if (name.length > 0) { modules.push(name) }
}

let block = exemptionsBlock(fs.read(ROOT))
var exemptions = {}
for (line in block.split("\n")) {
    let trimmed = line.trim()
    // A real entry line starts with the module's quoted name; the comments in this
    // map carry apostrophes, and scanning any line for a quoted value reads the
    // text between two apostrophes as a module that does not exist.
    if (!trimmed.startsWith("'")) { continue }
    let module = quotedAfter(trimmed, "")
    if (module.length == 0) { continue }
    exemptions.put(module, [digitsAfter(trimmed, "line:"), digitsAfter(trimmed, "branch:")])
}

// An exemption for a module settings.gradle no longer includes wires a task
// that never exists; the entry reads as protection and costs nothing.
var findings = []
for (m in keys(exemptions)) {
    if (!modules.contains(m)) {
        findings.push("${ROOT} exempts ${m}, which settings.gradle does not include")
    }
}

// One exemption value: a ratio must be written, parse, and sit in (0,1]. A
// missing or malformed number is reported as itself, never compared against 0.
fun exemptionProblem(which, text) {
    if (text.length == 0 or text == "." or !text.contains(".")) {
        let shown = if (text.length == 0) "absent" else text
        return "${which} exemption is not a written number (${shown})"
    }
    let ratio = text.toDouble()
    if (ratio <= 0 or ratio > 1) {
        return "${which} exemption ${text} is not a ratio in (0,1]"
    }
    return ""
}

var rows = []
for (m in modules) {
    let suite = countJava("${m}/src/test/java")
    let exemption = exemptions.get(m)
    if (exemption == null) {
        rows.push([m, "1.0 (100%)", "1.0 (100%)", str(suite)])
    } else {
        if (suite == 0) {
            findings.push("${m} has an exemption and no test source under src/test/java, so its jacocoTestCoverageVerification can never fail")
        }
        let lineProblem = exemptionProblem("line", exemption[0])
        if (lineProblem.length > 0) { findings.push("${m} ${lineProblem}") }
        let branchProblem = exemptionProblem("branch", exemption[1])
        if (branchProblem.length > 0) { findings.push("${m} ${branchProblem}") }
        rows.push([m, exemption[0], exemption[1], str(suite)])
    }
}

// The exemptions have to stay true in both directions: every EXEMPT entry
// must be in the build.gradle map, and vice versa.
for (m in keys(EXEMPT)) {
    if (!exemptions.has(m) && !modules.contains(m)) {
        findings.push("${m} is exempted here but settings.gradle does not include it")
    }
    if (countJava("${m}/src/test/java") == 0) {
        findings.push("${m} is exempted here and has no test source to exempt")
    }
}

// The other half of the honesty: a module outside every list is a module the
// gate has silently decided nothing about. Either it has a suite (and the build
// holds it to 100%, which is the intended state) or it has none and must be
// acknowledged in NO_SUITE.
for (m in modules) {
    let suite = countJava("${m}/src/test/java")
    if (suite == 0 and !NO_SUITE.has(m)) {
        findings.push("${m} has no test source under src/test/java and is not acknowledged in NO_SUITE, so no coverage rule and no PIT task apply to it while AGENTS.md says 100% is mandatory")
    }
    if (suite > 0 and NO_SUITE.has(m)) {
        findings.push("${m} now has ${suite} test source(s); delete its NO_SUITE acknowledgement, because jacocoTestCoverageVerification and pitest are applied to it")
    }
}

// A no-suite module must not also carry an exemption: the exemption would be a
// number attached to a task that does not exist.
for (m in keys(NO_SUITE)) {
    if (!modules.contains(m)) {
        findings.push("NO_SUITE names ${m}, which settings.gradle does not include")
    }
    if (exemptions.has(m)) {
        findings.push("${m} is acknowledged as having no suite but ${ROOT} still gives it a coverageExemptions floor")
    }
    if (NO_SUITE.get(m).length == 0) {
        findings.push("${m} is in NO_SUITE with no reason")
    }
}

// Every exemption must have a reason in the exemptionReasons map.
let rootText = fs.read(ROOT)
if (rootText.contains("exemptionReasons = [")) {
    for (m in keys(exemptions)) {
        let marker = "'" + m + "'"
        // Find the exemptionReasons block and check for the marker.
        let reasonAt = rootText.indexOf("exemptionReasons = [")
        let reasonEnd = rootText.indexOf("\n    ]", reasonAt)
        if (reasonAt >= 0 and reasonEnd >= 0) {
            let reasonBlock = rootText.substring(reasonAt, reasonEnd)
            if (!reasonBlock.contains(marker)) {
                findings.push("${m} has an exemption in ${ROOT} but no reason in exemptionReasons")
            }
        }
    }
}

// An exemption that is never applied is a comment, not a gate. The wiring
// lives outside the map (it reads coverageExemptions[project.name] for every
// module), so the whole build file is the text that has to carry it.
if (!rootText.contains("coverageExemptions[project.name]")) {
    findings.push("${ROOT} never looks a module up in coverageExemptions")
}
if (!rootText.contains("jacocoTestCoverageVerification")) {
    findings.push("the coverageExemptions map is never wired to jacocoTestCoverageVerification")
}
if (!rootText.contains("dependsOn 'jacocoTestCoverageVerification'")) {
    findings.push("jacocoTestCoverageVerification is configured but no check depends on it")
}

// The prose surface is checked further down, once AGENTS.md has been read: the
// document must not claim a rule that stops at two modules without saying where
// it stops.
fun skipSpace(text, from) {
    var i = from
    while (i < text.length) {
        let c = text.charAt(i)
        if (c == " " or c == "\t" or c == "\n") { i += 1 } else { break }
    }
    return i
}

fun readNumber(text, from) {
    var i = skipSpace(text, from)
    var digits = ""
    while (i < text.length) {
        let c = text.charAt(i)
        if (c == "." or (c >= "0" and c <= "9")) {
            digits += c
            i += 1
        } else {
            break
        }
    }
    return [digits, i]
}

let agentsText = fs.read(AGENTS)

// AGENTS.md's *Test coverage* note names the exemption map, so a rename that
// leaves the prose behind tells a reader a name the build no longer uses.
if (!agentsText.contains("coverageExemptions")) {
    findings.push("${AGENTS} does not reference coverageExemptions; update the Test coverage section")
}
// The stronger half: the document states that 100% line and branch coverage is
// mandatory. For a module with no suite the build enforces nothing, so the
// document has to carry the exception itself or its sentence is a claim about a
// tree it does not describe.
if (!agentsText.contains("no test suite")) {
    findings.push("${AGENTS} states that 100% coverage is mandatory without saying that some modules have no test suite at all, so a reader takes the rule to reach every module when it reaches neither of those two")
}
for (m in keys(NO_SUITE)) {
    if (!agentsText.contains(m)) {
        findings.push("${AGENTS} does not name ${m}, which is one of the modules the 100% rule does not reach")
    }
}
if (!agentsText.contains("coverage-floors.mnd")) {
    findings.push("${AGENTS} does not name coverage-floors.mnd, the gate that keeps this file's numbers and the build's honest about each other")
}
if (!agentsText.contains("mutationExemptions")) {
    findings.push("${AGENTS} does not reference mutationExemptions; the PIT rule it states has a floor map the document never mentions")
}
var prosePairs = 0
for (m in keys(exemptions)) {
    var rest = agentsText
    loop {
        let mark = "`${m}`"
        let at = rest.indexOf(mark)
        if (at < 0) { break }
        let after = rest.substring(at + mark.length)
        let lineEx = readNumber(after, 0)
        let slash = skipSpace(after, lineEx[1])
        let branchEx = readNumber(after, slash + 1)
        if (lineEx[0].contains(".") and slash < after.length and after.charAt(slash) == "/" and branchEx[0].contains(".")) {
            prosePairs += 1
            if (lineEx[0] != exemptions.get(m)[0]) {
                findings.push("${AGENTS} says ${m} line exemption ${lineEx[0]}, ${ROOT} enforces ${exemptions.get(m)[0]}")
            }
            if (branchEx[0] != exemptions.get(m)[1]) {
                findings.push("${AGENTS} says ${m} branch exemption ${branchEx[0]}, ${ROOT} enforces ${exemptions.get(m)[1]}")
            }
        }
        rest = after
    }
}

println("module                line    branch  tests")
for (r in rows) {
    println("  ${r[0].padEnd(20)}${r[1].padEnd(8)}${r[2].padEnd(8)}${r[3]}")
}
println("${length(keys(exemptions))} exemption(s) over ${length(modules)} module(s), " +
        "${length(keys(EXEMPT))} documented exemption reason(s), " +
        "${prosePairs} exemption(s) quoted in ${AGENTS}")

// The modules the rule does not reach, printed instead of implied. A table of
// floors that quietly omits two modules reads as a table of a tree that is
// gated; saying which rows are missing is what makes the rest of it true.
println("no suite - no coverage rule and no PIT task is applied to these at all:")
for (m in keys(NO_SUITE)) {
    println("  ${m.padEnd(20)}${NO_SUITE.get(m)}")
}

if (findings.length == 0) {
    println("every exemption names a module with a suite and a reason, every suite is exempt or held to 100%, and every module with no suite is acknowledged rather than absent")
} else {
    for (f in findings) { println("  EXEMPTION GAP  ${f}") }
    error("${findings.length} coverage-exemption finding(s)", "ViolationError")
}
