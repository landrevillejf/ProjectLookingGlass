#!/usr/bin/env mandela
// whats-new.mnd — feed every "what's new" surface from CHANGELOG.md.
//
// The JavaHelp guide could only ever say what a person remembered to write into
// a topic, so it went stale the day its refresh pull request merged, and the
// desktop's own release notes were unreadable from inside the desktop. Every
// feature pull request already updates the changelog, so make the guide read
// that instead: the three most recently RELEASED sections become a topic (never
// [Unreleased] -- a build's "what's new" names only what that build ships, and
// unreleased work is by definition not in the reader's desktop yet), and the
// full-text indexer (which globs every *.html in the topic directory) picks it up
// with no extra wiring.
//
// The same parse now answers for a second audience. A release has to publish a
// page of its own on the documentation site, so one section per released version
// becomes documentation/releases/<version>.html, with an index listing them. The
// Update Manager reads the very same document through -Dupdate.changelog.path, so
// the desktop dialog, the help topic and the site cannot disagree: one source,
// one renderer, three readers. Writing a second generator for either of the two
// new surfaces would duplicate this parse and drift from it on the first edit.
//
// The script is both halves, the way the other tools in this directory are:
//
//     ./gradlew :lg3d-mandela:whatsNewRefresh    (render and write every page)
//     ./gradlew :lg3d-mandela:whatsNewCheck      (gate: are they all current?)
//
// or by hand, with ` -s . ` confining the paths below to the repository root:
//
//     java -jar lg3d-mandela/build-gradle/libs/lg3d-mandela-1.68.0-dev.jar \
//         run scripts/mandela/whats-new.mnd write -s .
//
// The mode word is a positional word, not a `--flag`: the CLI reserves anything
// that starts with a dash, so an unknown `--write` would be a usage error.
//
//   args[0]  "write" renders and replaces every page; anything else only checks.

use std.fs

let SOURCE = "CHANGELOG.md"
let TOPIC_DIR = "lg3d-apps/src/classes/org/jdesktop/lg3d/apps/help/helpcontent"
let TOPIC = TOPIC_DIR + "/whats-new.html"
let SITE_DIR = "documentation/releases"
let SITE_INDEX = SITE_DIR + "/index.html"
let TAG_BASE = "https://github.com/landrevillejf/ProjectLookingGlass/releases/tag/"
let BLOB_BASE = "https://github.com/landrevillejf/ProjectLookingGlass/blob/main/"
let MARKER = "generated by scripts/mandela/whats-new.mnd from CHANGELOG.md - do not edit"
let KEEP_RELEASES = 3        // the three newest RELEASES; [Unreleased] is never a
                             // "what's new", and the archive keeps every release

// ---------------------------------------------------------------------------
// text plumbing (the language has no regex, so this scans and slices)
// ---------------------------------------------------------------------------

// The authored topics are pure ASCII and the JavaHelp renderer is given no
// charset to argue with, so the typographic characters the changelog favours
// become HTML entities. Anything rarer passes through, which is why the page
// declares UTF-8 in its head.
let FROM = ["—", "–", "→", "←", "↑", "↔", "…", "§",
            "“", "”", "’", "×", "·", "°", "«", "»",
            "≈", "≤", "±", "−", "é", "ç", "✓", "✗", "▸"]
let TO = ["&mdash;", "&ndash;", "&rarr;", "&larr;", "&uarr;", "&harr;", "&hellip;", "&sect;",
          "&ldquo;", "&rdquo;", "&rsquo;", "&times;", "&middot;", "&deg;", "&laquo;", "&raquo;",
          "&asymp;", "&le;", "&plusmn;", "&minus;", "&eacute;", "&ccedil;",
          "&#10003;", "&#10007;", "&#9656;"]

// HTML escapes first, then the entities: reversed, the ampersands this function
// introduces would be escaped a second time into visible "&amp;mdash;".
// A changelog author writes `&` as the entity &amp; in markdown, so the known
// entities are decoded back to characters before the escape pass - otherwise the
// page renders the entity's own name. &amp; is decoded last, so a double-encoded
// &amp;lt; stays the literal text &lt; it claims to be instead of becoming a tag.
fun plain(text) {
    var out = text.replace("&lt;", "<")
    out = out.replace("&gt;", ">")
    out = out.replace("&quot;", "\"")
    out = out.replace("&amp;", "&")
    out = out.replace("&", "&amp;")
    out = out.replace("<", "&lt;")
    out = out.replace(">", "&gt;")
    var i = 0
    while (i < FROM.length) {
        out = out.replace(FROM[i], TO[i])
        i += 1
    }
    return out
}

// The earliest of three indexOf results, or -1 when none of them matched.
fun firstOf(a, b, c) {
    var best = -1
    for (v in [a, b, c]) {
        if (v >= 0) {
            if (best < 0 || v < best) { best = v }
        }
    }
    return best
}

// How a code span is delimited: a run of backticks is closed by the next run of
// exactly the same length, and a run of another length is the literal text being
// quoted rather than the delimiter. That distinction is the whole reason a
// changelog can write ` ```mermaid ` to mean "an unfenced mermaid fence": counted
// as single backticks, that line opens its span on the first one, skips the three
// it is quoting, and closes on the last, which is what the author meant. Counted
// as one, the same line renders the rest of the paragraph as source code.
fun tickRun(text) {
    var n = 0
    while (n < text.length && text.charAt(n) == "`") { n += 1 }
    return n
}

// Where a run of exactly `count` backticks begins at or after `from`, or -1.
fun tickClose(text, count, from) {
    var i = from
    while (i < text.length) {
        if (text.charAt(i) == "`") {
            let run = tickRun(text.substring(i))
            if (run == count) { return i }
            i += run
        } else { i += 1 }
    }
    return -1
}

// One leading and one trailing space are padding, not content: they are how an
// author puts a backtick inside a code span. Only stripped as a pair, and never
// from a span that is nothing but spaces.
fun codeText(text) {
    if (text.length < 3) { return text }
    if (!text.startsWith(" ") || !text.endsWith(" ")) { return text }
    if (text.trim().length == 0) { return text }
    return text.substring(1, text.length - 1)
}

// A changelog links the repository as it lies on disk: `docs/x.md` names the file
// at the root. Put that href in a page under documentation/releases/ and it
// resolves against that directory and lands nowhere, which is exactly what the
// htmlLinksCheck gate exists to catch. So a page rendered for the site re-bases a
// repository-relative target onto the repository's own blob URL - the one address
// that resolves from a checkout, from the published site and from a reader's fork.
// An in-page anchor and an absolute URL are already addressed, and the help topic
// (which passes no base) keeps the author's text byte for byte, as it always did.
let ALREADY_ADDRESSED = ["#", "//", "http://", "https://", "mailto:", "tel:",
                         "data:", "file:"]

fun isAddressed(target) {
    return ALREADY_ADDRESSED.any { p -> target.startsWith(p) }
}

fun linkHref(target, base) {
    if (base.length == 0 || isAddressed(target)) { return target }
    return base + target
}

// One changelog line's worth of markdown, as HTML: `code`, **bold** and
// [text](url). Each step takes the earliest marker, emits the plain text before
// it, then consumes the marker; an unbalanced marker is left exactly as typed
// rather than swallowing the rest of the line, because a changelog that writes
// "the ** flag" is a changelog that stays readable here. A code span is matched
// by the length of its backtick run, so a quoted fence does not open a span -
// see tickRun/tickClose below.
// The spans, over text plain() has already escaped exactly once. A nested call
// must come back here rather than to inline(), or the entities this pass
// introduces get escaped again and the page shows "&amp;mdash;". It is written
// before inline() because the language binds a name where it is declared, and a
// forward reference is an unknown name at compile time.
fun markup(text, base) {
    var rest = text
    var out = ""
    while (rest.length > 0) {
        let at = firstOf(rest.indexOf("**"), rest.indexOf("`"), rest.indexOf("["))
        if (at < 0) {
            return out + rest
        }
        out += rest.substring(0, at)
        rest = rest.substring(at)
        if (rest.startsWith("**")) {
            let tail = rest.substring(2)
            let close = tail.indexOf("**")
            if (close < 0) { return out + rest }
            // The title's own inner spans are converted too: the changelog writes
            // **An `Int` that overflows...**, and emitting the bold raw would show
            // the backticks to the reader.
            out += "<strong>" + markup(tail.substring(0, close), base) + "</strong>"
            rest = tail.substring(close + 2)
        } else if (rest.startsWith("`")) {
            let count = tickRun(rest)
            let close = tickClose(rest, count, count)
            if (close < 0) {
                // No run of this length closes it, so the backticks are the text
                // itself: emit the run and keep scanning, or a quoted fence would
                // also throw away every span later in the line.
                out += rest.substring(0, count)
                rest = rest.substring(count)
            } else {
                out += "<code>" + codeText(rest.substring(count, close)) + "</code>"
                rest = rest.substring(close + count)
            }
        } else {
            let tail = rest.substring(1)                      // drop the "["
            let hit = tail.indexOf("](")
            if (hit < 0) {                                    // a bracket, not a link
                out += "["
                rest = tail
            } else {
                let label = tail.substring(0, hit)
                let after = tail.substring(hit + 2)
                let stop = after.indexOf(")")
                if (stop < 0) {
                    out += "[" + label + "]("
                    rest = after
                } else {
                    out += "<a href=\"" + linkHref(after.substring(0, stop), base) +
                           "\">" + markup(label, base) + "</a>"
                    rest = after.substring(stop + 1)
                }
            }
        }
    }
    return out
}

// One changelog line's worth of markdown as HTML: escape, then convert.
fun inline(raw, base) {
    return markup(plain(raw), base)
}

// The bold lead of a bullet is its title, and a title is what a help topic would
// have to name for the feature to count as documented.
fun titleOf(raw) {
    if (!raw.startsWith("**")) { return raw }
    let tail = raw.substring(2)
    let close = tail.indexOf("**")
    if (close < 0) { return raw }
    return tail.substring(0, close)
}

// A changelog bullet is written "**Title** (scope) - narrative": the headline is
// what a reader of a help page scans, and the paragraph explaining why belongs
// to the changelog this page links to. The separator is searched for only after
// the closing `**`, because a title may itself contain one (**A Bug Reporter app
// - the manual half of it**) and cutting inside the bold would leave the reader
// staring at stray asterisks. A bullet with no such shape is kept whole, since
// re-cutting a sentence somebody wrote differently is worse than one long line.
fun headline(raw) {
    if (!raw.startsWith("**")) { return raw }
    let tail = raw.substring(2)
    let close = tail.indexOf("**")
    if (close < 0) { return raw }
    let rest = tail.substring(close + 2)
    let at = rest.indexOf(" \u2014 ")
    if (at < 0) { return raw }
    return "**" + tail.substring(0, close) + "**" + rest.substring(0, at)
}

// ---------------------------------------------------------------------------
// reading the changelog
// ---------------------------------------------------------------------------

// "## [Unreleased] — 1.69.0-dev — ..." names its section between the brackets.
fun headerTitle(line) {
    let open = line.indexOf("[")
    let close = line.indexOf("]")
    if (open < 0 || close < open) { return "" }
    return line.substring(open + 1, close)
}

// The same header, as the <h2> text: the brackets are markdown's, not prose's.
fun headerLabel(line) {
    return line.substring(3).replace("[", "").replace("]", "").trim()
}

// A header's tail is written "1.68.0 — 2026-10-11 — Gradle / JDK 21 modernization":
// the date is the part that reads as one, and the summary is what is left after
// the version and the date. No regex here either - the parts are counted out, and
// a header that carries no date (the [Unreleased] one names the version under
// development instead) simply answers empty, which the page below renders as a
// dash rather than as an invention.
fun isDate(part) {
    if (part.length != 10) { return false }
    if (part.charAt(4) != "-") { return false }
    if (part.charAt(7) != "-") { return false }
    let digits = "0123456789"
    for (i in [0, 1, 2, 3, 5, 6, 8, 9]) {
        if (!digits.contains(part.charAt(i))) { return false }
    }
    return true
}

fun headerDate(label) {
    let parts = label.split(" \u2014 ")
    if (parts.length > 1 && isDate(parts[1])) { return parts[1] }
    return ""
}

fun headerSummary(label) {
    let parts = label.split(" \u2014 ")
    if (parts.length < 2) { return "" }
    if (isDate(parts[1])) {
        if (parts.length < 3) { return "" }
        return parts.slice(2).join(" \u2014 ")
    }
    return parts.slice(1).join(" \u2014 ")
}

// Every section of the changelog, in document order, as
// [start, stop, label, version, date, summary] - line indices and text. A second
// bare [Unreleased] (a feature branch opening one above its own release) is a
// drafting artifact, so the filter below keeps the first of them only.
fun headersOf(lines) {
    var at = []
    var title = []
    var label = []
    var i = 0
    while (i < lines.length) {
        if (lines[i].startsWith("## [")) {
            at.push(i)
            title.push(headerTitle(lines[i]))
            label.push(headerLabel(lines[i]))
        }
        i += 1
    }
    var all = []
    var k = 0
    while (k < at.length) {
        var stop = lines.length
        if (k + 1 < at.length) { stop = at[k + 1] }
        all.push([at[k], stop, label[k], title[k],
                  headerDate(label[k]), headerSummary(label[k])])
        k += 1
    }
    return all
}

// The sections worth a place in the help topic: the three newest RELEASES, and
// never [Unreleased]. A "What's New" a person reads inside a shipped build must
// name only what that build can do -- [Unreleased] is work that has not shipped,
// so listing it advertises a feature the reader's desktop does not have. The
// archive below takes every release for the same reason: an archive that forgets
// its old versions is a changelog with amnesia.
fun sectionsOf(lines) {
    var kept = []
    var released = 0
    for (h in headersOf(lines)) {
        if (h[3] == "Unreleased") { continue }
        if (released < KEEP_RELEASES) {
            kept.push(h)
            released += 1
        }
    }
    return kept
}

// The bullets of one section as a flat [kind, depth, text] walk in document
// order. A bullet's continuation lines are the indented, non-blank, non-bullet
// lines under it - Keep a Changelog indents exactly two spaces for both a
// wrap and a sub-bullet, so a line that starts with "- " after the indent is a
// child item and anything else belongs to the sentence being read.
fun entriesOf(lines, from, to) {
    var items = []
    var kind = ""
    var i = from + 1                        // the "## [...]" header is not a bullet
    while (i < to) {
        let line = lines[i]
        let text = line.trim()
        if (text.startsWith("### ")) {
            kind = text.substring(4).trim()
        } else if (text.startsWith("- ") && kind.length > 0) {
            var depth = 0
            if (!line.startsWith("- ")) { depth = 1 }
            var body = text.substring(2).trim()
            var j = i + 1
            while (j < to) {
                let next = lines[j]
                let tnext = next.trim()
                if (tnext.length == 0) { break }
                if (tnext.startsWith("### ")) { break }
                if (next.startsWith("- ")) { break }
                if (!next.startsWith("  ")) { break }
                if (tnext.startsWith("- ")) { break }
                body += " " + tnext
                j += 1
            }
            items.push([kind, depth, body])
            i = j - 1                       // the outer += 1 lands on j
        }
        i += 1
    }
    return items
}

// The only nesting a changelog uses is one level of sub-bullets, so model
// exactly that: [kind, entries] where an entry is [text, subtexts]. Grouping up
// front keeps the writer below free of an open-tag/close-tag state machine.
fun tree(items) {
    var groups = []
    var entries = []
    var kind = ""
    var text = ""
    var subs = []
    var have = false
    for (it in items) {
        if (it[0] != kind) {
            if (have) { entries.push([text, subs]); have = false }
            if (kind.length > 0) { groups.push([kind, entries]) }
            kind = it[0]
            entries = []
        }
        if (it[1] == 0) {
            if (have) { entries.push([text, subs]) }
            text = it[2]
            subs = []
            have = true
        } else if (have) {
            subs.push(it[2])
        } else {
            text = it[2]                    // a sub-bullet orphaned by an edit
            subs = []
            have = true
        }
    }
    if (have) { entries.push([text, subs]) }
    if (kind.length > 0) { groups.push([kind, entries]) }
    return groups
}

// ---------------------------------------------------------------------------
// the pages, in two skins over one body
// ---------------------------------------------------------------------------

// Every released section as [version, label, date, summary, groups]. [Unreleased]
// is not a release: it names work that has not shipped, and a page for it would
// promise a download that does not exist.
fun releasesOf(lines) {
    var out = []
    for (h in headersOf(lines)) {
        if (h[3] == "Unreleased") { continue }
        out.push([h[3], h[2], h[4], h[5], tree(entriesOf(lines, h[0], h[1]))])
    }
    return out
}

// The sections as HTML: the header's own text as a heading, then the changelog's
// groups as lists. Deterministic by construction - no timestamp, nothing read
// from the filesystem into the body - which is what lets the gate compare a
// committed page byte for byte instead of guessing that a regenerated page
// "looks the same".
//
// The one difference between the two audiences is how much of a bullet they
// show: a help page cuts it to the headline, because a reader scanning a guide
// wants the name of the feature; a release page keeps the narrative, because the
// page exists precisely for the paragraph the cut throws away.
fun bodyOf(sections, cut, base) {
    var out = []
    for (s in sections) {
        out.push("  <h2>" + plain(s[0]) + "</h2>")
        out.push("")
        if (length(s[1]) == 0) {
            out.push("  <p class=\"tip\">This section carries no bullets.</p>")
        }
        for (g in s[1]) {
            out.push("  <h3>" + plain(g[0]) + "</h3>")
            out.push("  <ul>")
            for (e in g[1]) {
                var text = e[0]
                if (cut) { text = headline(e[0]) }
                out.push("    <li>" + inline(text, base))
                if (length(e[1]) > 0) {
                    out.push("      <ul>")
                    for (sub in e[1]) {
                        out.push("        <li>" + inline(sub, base) + "</li>")
                    }
                    out.push("      </ul>")
                }
                out.push("    </li>")
            }
            out.push("  </ul>")
            out.push("")
        }
    }
    return out
}

// Three lists of lines as one document. The language has no array concatenation
// to lean on, so the walk is spelled once here instead of in every skin.
fun assemble(head, body, foot) {
    var out = []
    for (line in head) { out.push(line) }
    for (line in body) { out.push(line) }
    for (line in foot) { out.push(line) }
    return out.join("\n") + "\n"
}

// Skin one: the JavaHelp topic. HTML 3.2 and the guide's own stylesheet, because
// the help renderer is given nothing else to read.
fun topicHead() {
    var out = []
    out.push("<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 3.2//EN\">")
    out.push("<!-- " + MARKER + " -->")
    out.push("<html lang=\"en\">")
    out.push("<head>")
    out.push("  <meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\">")
    out.push("  <title>What's New in Project Looking Glass</title>")
    out.push("  <link rel=\"stylesheet\" type=\"text/css\" href=\"lg3d-help.css\">")
    out.push("</head>")
    out.push("<body>")
    out.push("  <h1>What's New in Project Looking Glass</h1>")
    out.push("")
    out.push("  <p class=\"note\">This page is generated from <code>CHANGELOG.md</code> by")
    out.push("  <code>scripts/mandela/whats-new.mnd</code> and shows the three most recent")
    out.push("  released versions - never the unreleased work in progress, which is not in")
    out.push("  the build a reader is running. Refresh it with")
    out.push("  <code>./gradlew :lg3d-mandela:whatsNewRefresh</code> after editing the")
    out.push("  changelog - never edit this HTML, a CI gate compares it against the")
    out.push("  changelog line by line.</p>")
    out.push("")
    return out
}

fun topicFoot() {
    var out = []
    out.push("  <div class=\"nav\">")
    out.push("    Back to <a href=\"overview.html\">Overview</a>, or read the entire history")
    out.push("    in the")
    out.push("    <a href=\"https://github.com/landrevillejf/ProjectLookingGlass/blob/main/CHANGELOG.md\">CHANGELOG.md</a>.")
    out.push("  </div>")
    out.push("</body>")
    out.push("</html>")
    return out
}

fun renderTopic(sections) {
    return assemble(topicHead(), bodyOf(sections, true, ""), topicFoot())
}

// Skin two: the Pages archive. The site has no stylesheet file to link - each of
// its pages carries an inline <style>, the portal included - so the archive
// repeats the portal's palette rather than inventing a third look. It is written
// as lines, not as one long string, so the generated file reads as HTML.
let SITE_CSS = [
    "    body { margin: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI',",
    "           Roboto, Oxygen, Ubuntu, Cantarell, sans-serif; line-height: 1.6;",
    "           color: #333; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); }",
    "    main { max-width: 960px; margin: 0 auto; padding: 2rem; }",
    "    h1 { font-size: 2rem; margin-top: 0; }",
    "    h2 { font-size: 1.4rem; margin-top: 2rem;",
    "           border-bottom: 2px solid rgba(0, 0, 0, 0.1); padding-bottom: 0.3rem; }",
    "    h3 { font-size: 1.1rem; margin-top: 1.5rem; }",
    "    p, li { max-width: 70ch; }",
    "    ul { padding-left: 1.5rem; }",
    "    li { margin: 0.6rem 0; }",
    "    code { background: rgba(0, 0, 0, 0.06); padding: 0.1rem 0.35rem; border-radius: 3px; }",
    "    a { color: #4a51a8; }",
    "    .back, .meta { font-size: 0.95rem; }",
    "    .note { background: rgba(255, 255, 255, 0.7); border-left: 4px solid #667eea;",
    "            padding: 0.8rem 1rem; }",
    "    table { border-collapse: collapse; width: 100%; }",
    "    th, td { text-align: left; padding: 0.5rem 0.75rem;",
    "             border-bottom: 1px solid rgba(0, 0, 0, 0.1); }"
]

// Where a release's test reports live, and what they cover. Said on every page
// because the reports are not committed here: they are published beside the page
// and attached to the GitHub release, and a reader who does not know that reads a
// missing directory as a missing report.
let REPORT_NOTE = [
    "  <p class=\"note\">The test reports of a published release are generated beside this ", 
    "  page: <code>&lt;version&gt;/reports/</code> carries the JUnit, JaCoCo, Cucumber ", 
    "  and PIT mutation reports of every module with a test suite. Each module runs ", 
    "  report-only (<code>mutationThreshold = 0</code>, no gate) unless it appears in the ", 
    "  <code>mutationExemptions</code> map, where it is gated at the score its own suite really achieves. ", 
    "  The same tree is attached to the GitHub release as <code>reports-&lt;version&gt;.zip</code>, ", 
    "  so a report outlives a rebuilt site.</p>"
]

// The line the release workflow substitutes for a list of links into the report
// tree it publishes under this page. A comment and not an href, because that tree
// is never committed: a committed link into it would be a dead link in every
// checkout, which is exactly what the htmlLinksCheck gate is for. A release the
// workflow has not published yet keeps the comment and reads the note above -
// nothing broken, nothing invented.
let REPORT_SLOT = "  <!-- test-reports -->"

fun siteHead(title) {
    var out = []
    out.push("<!DOCTYPE html>")
    out.push("<!-- " + MARKER + " -->")
    out.push("<html lang=\"en\">")
    out.push("<head>")
    out.push("  <meta charset=\"UTF-8\">")
    out.push("  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">")
    out.push("  <title>" + plain(title) + "</title>")
    out.push("  <style>")
    for (rule in SITE_CSS) { out.push(rule) }
    out.push("  </style>")
    out.push("</head>")
    out.push("<body>")
    out.push("  <main>")
    return out
}

fun siteFoot() {
    var out = []
    out.push("  </main>")
    out.push("</body>")
    out.push("</html>")
    return out
}

// The line under a release's title. A header that carries no date says nothing
// about one, rather than dating the release with the day it was written.
fun releaseMeta(r) {
    var out = ""
    if (r[2].length > 0) {
        out += plain(r[2]) + " &middot; "
    }
    out += "<a href=\"" + TAG_BASE + "v" + r[0] + "\">GitHub release</a> &middot;"
    out += " <a href=\"" + BLOB_BASE + SOURCE + "\">" + SOURCE + "</a>"
    return out
}

// One release, one page: its own section of the changelog and nothing else, with
// the links the rest of the site is reachable by, so a deep link into an old
// version never strands a reader.
fun renderRelease(r) {
    var body = []
    body.push("  <p class=\"back\"><a href=\"../index.html\">Documentation</a> &middot;")
    body.push("  <a href=\"index.html\">All releases</a></p>")
    body.push("")
    body.push("  <h1>Project Looking Glass " + plain(r[0]) + "</h1>")
    body.push("  <p class=\"meta\">Released " + releaseMeta(r) + "</p>")
    body.push("")
    var sections = []
    sections.push([r[1], r[4]])
    for (line in bodyOf(sections, false, BLOB_BASE)) { body.push(line) }
    body.push(REPORT_SLOT)
    for (line in REPORT_NOTE) { body.push(line) }
    return assemble(siteHead("Release " + r[0] + " - Project Looking Glass"),
                    body, siteFoot())
}

// The archive's own index: one row per released version, the date and the
// section's summary beside it, and the GitHub release each row describes.
fun renderIndex(releases) {
    var body = []
    body.push("  <p class=\"back\"><a href=\"../index.html\">Documentation</a></p>")
    body.push("")
    body.push("  <h1>Releases</h1>")
    body.push("")
    body.push("  <p>One page per released version, generated from <code>CHANGELOG.md</code>")
    body.push("  by <code>scripts/mandela/whats-new.mnd</code>. The work in progress is not")
    body.push("  listed here, nor in the desktop's own <em>What's New</em> help topic - both")
    body.push("  name released versions only - so it lives in the")
    body.push("  <a href=\"" + BLOB_BASE + SOURCE + "\">full changelog</a> alone.</p>")
    body.push("")
    body.push("  <table>")
    body.push("    <tr><th>Version</th><th>Released</th><th>Section</th>")
    body.push("    <th>GitHub release</th></tr>")
    for (r in releases) {
        var date = "&mdash;"
        if (r[2].length > 0) { date = plain(r[2]) }
        var summary = r[3]
        if (summary.length == 0) { summary = r[1] }
        body.push("    <tr><td><a href=\"" + r[0] + ".html\">" + plain(r[0]) + "</a></td>")
        body.push("    <td>" + date + "</td><td>" + plain(summary) + "</td>")
        body.push("    <td><a href=\"" + TAG_BASE + "v" + r[0] + "\">v" + plain(r[0]) + "</a></td></tr>")
    }
    body.push("  </table>")
    body.push("")
    for (line in REPORT_NOTE) { body.push(line) }
    return assemble(siteHead("Releases - Project Looking Glass"), body, siteFoot())
}

fun isReleased(releases, version) {
    return releases.any { r -> r[0] == version }
}

// What the gate compares, byte for byte: the help topic, one page per released
// version and the archive's index - and any page that names a version the
// changelog no longer carries, because a page nobody regenerates is a page
// nobody deletes.
fun stalePages(releases, topic, indexPage) {
    var problems = []
    if (!fs.exists(TOPIC)) {
        problems.push("the help topic is missing")
    } else if (fs.read(TOPIC) != topic) {
        problems.push("the help topic is stale")
    }
    for (r in releases) {
        let page = SITE_DIR + "/" + r[0] + ".html"
        if (!fs.exists(page)) {
            problems.push("the page for " + r[0] + " is missing")
        } else if (fs.read(page) != renderRelease(r)) {
            problems.push("the page for " + r[0] + " is stale")
        }
    }
    if (fs.exists(SITE_DIR)) {
        for (name in fs.list(SITE_DIR)) {
            if (!name.endsWith(".html")) { continue }
            if (name == "index.html") { continue }
            if (!isReleased(releases, name.substring(0, name.length - 5))) {
                problems.push("the page " + name + " names no release")
            }
        }
    }
    if (!fs.exists(SITE_INDEX)) {
        problems.push("the release index is missing")
    } else if (fs.read(SITE_INDEX) != indexPage) {
        problems.push("the release index is stale")
    }
    return problems
}

// Entries announced as Added that no other topic names are the ones a reader can
// only learn about from this page's one-line summary: the honest inventory of
// where a real new topic is in order. Report-only on purpose, because only a
// stale page may fail the build.
fun unwrittenOnes(sections) {
    var haystack = ""
    for (name in fs.list(TOPIC_DIR)) {
        if (!name.endsWith(".html")) { continue }
        if (name == "whats-new.html") { continue }
        haystack += fs.read(TOPIC_DIR + "/" + name).lower()
    }
    var missing = []
    for (s in sections) {
        for (g in s[1]) {
            if (g[0] != "Added") { continue }
            for (e in g[1]) {
                let title = titleOf(e[0]).lower()
                if (!haystack.contains(title)) { missing.push(title) }
            }
        }
    }
    return missing
}

// ---------------------------------------------------------------------------
// main
// ---------------------------------------------------------------------------

if (!fs.exists(SOURCE)) {
    error(SOURCE + " is missing from the sandbox root; run this with -s <repo>",
          "ViolationError")
}

let lines = fs.lines(SOURCE)
let headers = sectionsOf(lines)
if (length(headers) == 0) {
    error("CHANGELOG.md carries no released '## [version]' section, so there is "
          + "nothing available for the What's New topic to show", "ViolationError")
}

var sections = []
var entries = 0
for (h in headers) {
    var items = entriesOf(lines, h[0], h[1])
    entries += length(items)
    sections.push([h[2], tree(items)])
}

// A page per released version, beside the topic. Both come out of the same parse
// above, which is the entire point: the site and the help guide cannot disagree
// because they are the same render in two skins.
let page = renderTopic(sections)
let releases = releasesOf(lines)
let indexPage = renderIndex(releases)

let news = unwrittenOnes(sections)
// Interpolated, not concatenated: `+` refuses to mix a count with text, and a
// checker that only compiles would never notice, so keep numbers in "${}".
let sectionCount = length(sections)
let entryCount = entries
let newsCount = length(news)
var plural = "ies"
if (newsCount == 1) { plural = "y" }
println("${sectionCount} sections, ${entryCount} entries rendered from ${SOURCE}")
println("  ${newsCount} Added entr${plural} not named in any other help topic " +
        "(a new topic may be in order)")
// A headline is prose, not a symbol, so this search over-reports: it is a short
// reminder, never a verdict, and it is capped so it cannot bury the gate's own
// finding under a page of titles.
var shown = 0
for (n in news) {
    if (shown >= 5) { break }
    println("    " + n)
    shown += 1
}
if (newsCount > 5) { println("    ... and ${newsCount - 5} more") }

let writing = length(args) > 0 && args[0] == "write"
// The archive's own count: one page per released version, plus the index listing
// them. The topic is not part of it - it belongs to the help guide.
let pageCount = length(releases) + 1
if (writing) {
    // fs.write does not create the directories above the file it opens, and the
    // archive is a directory this repository has never had.
    if (!fs.exists(SITE_DIR)) { fs.mkdir(SITE_DIR) }
    fs.write(TOPIC, page)
    for (r in releases) {
        fs.write(SITE_DIR + "/" + r[0] + ".html", renderRelease(r))
    }
    fs.write(SITE_INDEX, indexPage)
    println("wrote ${TOPIC} and ${pageCount} pages under ${SITE_DIR}")
} else {
    // Names are counted out before the findings are printed, so the log says how
    // many pages a failure refers to instead of leaving a reader to count lines.
    let problems = stalePages(releases, page, indexPage)
    let problemCount = length(problems)
    for (p in problems) { println("  stale or missing: " + p) }
    if (problemCount > 0) {
        // A missing page, a page somebody hand-edited and a page naming a version
        // the changelog no longer carries are three different findings, and each is
        // named on its own line above; they share one failure because they share one
        // fix. Say what to run, and say nothing else, so the CI log reads as an
        // instruction rather than as a mystery.
        // The wording is deliberate: it names the task rather than a colon-
        // qualified Gradle path, because the CLI reads a message holding two
        // colons as a "file:line: text" prefix and prints only its tail - and an
        // instruction the log cut in half is exactly the mystery this branch
        // promised not to be. One message for every finding, because the fix of
        // each of them is the same command.
        error("${problemCount} generated page(s) no longer match " + SOURCE
              + "; run the whatsNewRefresh task of the lg3d-mandela module and commit "
              + "the regenerated topic, release pages and index", "ViolationError")
    }
    println("the help topic and ${pageCount} archive pages are current with " + SOURCE)
}
