#!/usr/bin/env mandela
// i18n-keys.mnd — the shell bundle contract, checked from the tree.
//
// Messages.tr() is the only way a shell label reaches the screen, and the
// mechanism degrades safely at runtime (a missing key echoes the key, a broken
// pattern echoes the pattern). Safe degradation is what makes a *silent* gap
// possible: a call site asking for a key nobody added, or a French entry that
// dropped a {0}, would ship without anyone noticing. This gate closes exactly
// that gap, and it is the kind of check bash does awkwardly (three files to
// parse, two directions of set comparison, placeholder arithmetic) and Java
// does overkill. Run from the repository root:
//
//     java -jar lg3d-mandela/build-gradle/libs/lg3d-mandela-1.68.0-dev.jar \
//         run scripts/mandela/i18n-keys.mnd -s .
//
// It checks three things:
//   1. every Messages.tr("...")/trOrDefault("...") literal in a *production*
//      source (src/classes, never src/test - tests probe deliberate misses)
//      exists in the base bundle;
//   2. every base key has a French twin and every French key exists in the
//      base - the same parity MessagesTest asserts at runtime, checked here
//      without a JVM or the locale resolution;
//   3. the {n} placeholders of a key agree between the two bundles, so a
//      translation can never drop or invent an argument.
// Exit code 0 when all three hold, 2 on any finding, so CI can branch on it.

use std.fs

let BASE = "lg3d-core/src/classes/org/jdesktop/lg3d/i18n/messages.properties"
let FRENCH = "lg3d-core/src/classes/org/jdesktop/lg3d/i18n/messages_fr.properties"

// Directories that are never sources: generated output, vendored code and the
// toolchain's own state. Dot-directories are skipped by prefix below.
let SKIP_DIRS = ["build", "build-gradle", "libs", "ext", "node_modules", "target"]

fun isSkipped(name) {
    name in SKIP_DIRS || name.startsWith(".")
}

// The two call shapes that take a literal key. trLgcfgName/trLgcfgDesc build
// their key from a descriptor name at runtime and are out of reach here; their
// keys still face check 2 and 3 as ordinary bundle entries.
let CALLS = ["Messages.tr(\"", "Messages.trOrDefault(\""]

fun javaFiles(dir, found) {
    for (name in fs.list(dir)) {
        if (isSkipped(name)) { continue }
        let path = if (dir == ".") name else "${dir}/${name}"
        if (fs.isDirectory(path)) {
            javaFiles(path, found)
        } else if (name.endsWith(".java") && path.contains("/src/classes/")) {
            found.push(path)
        }
    }
    return found
}

// Every key quoted on one line after a tracked call. The codebase keeps the
// literal on the call's own line (it is a key, not prose), so no join-across-
// lines is needed; a call that broke that style would surface here as a
// missing-key finding on the next run, not as a silent pass.
fun literalKeys(line, found) {
    for (call in CALLS) {
        var rest = line
        loop {
            let at = rest.indexOf(call)
            if (at < 0) { break }
            rest = rest.substring(at + call.length)
            let close = rest.indexOf("\"")
            if (close < 0) { break }
            found.push(rest.substring(0, close))
            rest = rest.substring(close)
        }
    }
    return found
}

// Read a .properties into a key list plus a key -> raw value map. The bundles
// use one key per line with no continuations (values carry \n escapes, which
// keeps this parser honest - if a real continuation is ever introduced, the
// orphan line would show up as a missing "=" and be skipped, flagging itself
// in check 1 as an unmet key long before shipping).
fun readBundle(path, keys, values) {
    for (line in fs.lines(path)) {
        let text = line.trim()
        if (text.length == 0 || text.startsWith("#")) { continue }
        let eq = text.indexOf("=")
        if (eq < 0) { continue }
        let key = text.substring(0, eq).trim()
        if (!values.has(key)) { keys.push(key) }
        values.put(key, text.substring(eq + 1))
    }
}

// The distinct {n} indices a pattern uses, as strings, order of appearance.
let DIGITS = "0123456789"

fun placeholders(value, out) {
    var rest = value
    loop {
        let open = rest.indexOf("{")
        if (open < 0) { break }
        rest = rest.substring(open + 1)
        let close = rest.indexOf("}")
        if (close < 0) { break }
        let head = rest.substring(0, close).split(",")[0].trim()
        if (head.length > 0 && DIGITS.contains(head) && !out.any { p -> p == head }) {
            out.push(head)
        }
        rest = rest.substring(close)
    }
    return out
}

fun samePlaceholders(a, b) {
    return a.all { x -> b.any { y -> y == x } } && b.all { x -> a.any { y -> y == x } }
}

if (!fs.exists(BASE)) { error("base bundle missing: ${BASE}", "ViolationError") }
if (!fs.exists(FRENCH)) { error("French bundle missing: ${FRENCH}", "ViolationError") }

var enKeys = []
var enValues = {}
var frKeys = []
var frValues = {}
readBundle(BASE, enKeys, enValues)
readBundle(FRENCH, frKeys, frValues)

// Check 1: every literal asked for in production code is a base-bundle key.
// A file the reader cannot decode as text (a legacy Latin-1 incubator source,
// say) cannot carry a Messages.tr call anybody added in UTF-8 style, so it is
// skipped - but named in the report, because a skipped file is a blind spot.
let files = javaFiles(".", [])
var missing = []
var unreadable = []
for (doc in files) {
    var lineNo = 0
    try {
        for (line in fs.lines(doc)) {
            lineNo += 1
            for (key in literalKeys(line, [])) {
                if (!enValues.has(key)) {
                    missing.push("${doc}:${lineNo} -> ${key} (not in messages.properties)")
                }
            }
        }
    } catch (e) {
        unreadable.push(doc)
    }
}

// Checks 2 and 3: the two bundles carry the same keys with the same
// placeholders, and no key is blank on either side.
var unbalanced = []
for (key in enKeys) {
    if (enValues.get(key).trim().length == 0) {
        unbalanced.push("${key} (blank English text)")
    }
    if (!frValues.has(key)) {
        unbalanced.push("${key} (no French twin)")
    } else if (!samePlaceholders(placeholders(enValues.get(key), []), placeholders(frValues.get(key), []))) {
        unbalanced.push("${key} (placeholders differ between bundles)")
    }
}
for (key in frKeys) {
    if (!enValues.has(key)) {
        unbalanced.push("${key} (French-only key, missing from the base)")
    } else if (frValues.get(key).trim().length == 0) {
        unbalanced.push("${key} (blank French text)")
    }
}

// The inventory: keys grouped by surface (every dotted prefix but the last
// segment), so a run doubles as the per-surface report.
var surfaces = []
var counts = {}
for (key in enKeys) {
    var parts = key.split(".")
    var i = 0
    var prefix = ""
    for (piece in parts) {
        i += 1
        if (i < parts.length) {
            prefix = if (prefix == "") piece else "${prefix}.${piece}"
        }
    }
    if (!counts.has(prefix)) { surfaces.push(prefix); counts.put(prefix, 0) }
    counts.put(prefix, counts.get(prefix) + 1)
}

println("checked ${files.length} production sources against ${enKeys.length} base key(s) / ${frKeys.length} French key(s)")
for (s in surfaces) {
    println("  ${s}: ${counts.get(s)} key(s)")
}
for (u in unreadable) {
    println("  unreadable, skipped: ${u}")
}

if (missing.length == 0 && unbalanced.length == 0) {
    println("bundle contract holds: every key used exists, en and fr agree")
} else {
    missing.forEach { m -> println("  missing key: ${m}") }
    unbalanced.forEach { u -> println("  bundle gap: ${u}") }
    error("${missing.length + unbalanced.length} i18n finding(s)", "ViolationError")
}
