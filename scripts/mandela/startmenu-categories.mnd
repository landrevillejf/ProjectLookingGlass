#!/usr/bin/env mandela
// startmenu-categories.mnd — read the start menu the way a user scans it.
//
// A start-menu item is filed under one menuGroup, but the only thing a person
// actually reads when hunting for an app is its name and one-line description.
// When the two disagree — an "image editor" filed under Utilities while its
// sibling "Image Editor" sits under Media, a "Paint" that draws images parked
// away from the other media tools — the item is a click harder to find, and
// nothing catches it because a menuGroup is free-form runtime configuration, not
// a type the compiler sees. This is the same class of gap startmenu-audit.mnd
// closes for resource references, aimed at the category label instead.
//
//     java -jar lg3d-mandela/build-gradle/libs/lg3d-mandela-1.69.0-dev.jar \
//         run scripts/mandela/startmenu-categories.mnd -s .
//
// It is a report, not a gate: like todo-scan.mnd and asset-report.mnd it always
// exits 0. Category is a judgement, and a keyword classifier over a short
// description is a hint a maintainer weighs, never a hard rule — turning a soft
// suggestion into a red build would teach everyone to ignore the gate. So the
// script reads every live descriptor's name and description, scores it against
// a keyword vocabulary for the eight groups the desktop ships, and prints the
// items whose declared group is beaten by a different group's evidence, plus a
// tally of how many agree and how many carry no signal at all. Only descriptors
// under the directories the desktop actually scans are read (see startmenu-
// audit.mnd's isLive), and only items that carry a menuGroup can disagree.

use std.fs

// The eight groups the live menu uses today, each with the words that, seen in
// an item's name or description, point at it. Order is the tie-break: an earlier
// row wins when two groups score the same, so the list reads most-specific first.
let CATEGORIES = [
    ["Games", ["chess", "solitaire", "sudoku", "tic-tac", "klondike", "puzzle",
        "game", "unbeatable ai", "vs a search engine"]],
    ["Education", ["periodic", "elements", "learn", "teach", "reference table",
        "quiz", "tutorial", "student", "118"]],
    ["Developers", ["database", "sql", "docker", "container", "compose", "git",
        "commit", "branch", "diff", "sync", "ide", "openapi", "swagger", "api",
        "payload", "http request", "collection", "environment", "yaml", "debug",
        "code generation", "source files"]],
    ["Internet", ["browser", "web", "ftp", "sftp", "ftps", "ssh", "imap", "smtp",
        "messenger", "irc", "conference", "jitsi", "vpn", "remote desktop", "rmi",
        "jxta", "network", "url", "http", "chat", "instant messag", "wonderland",
        "openvpn", "wireguard"]],
    ["Media", ["audio", "music", "radio", "podcast", "album", "cover", "image",
        "photo", "picture", "gallery", "video", "movie", "stream", "disc",
        "slideshow", "guitar", "bass", "tuner", "record", "capture the screen",
        "layers", "filters", "paint", "draw"]],
    ["Office", ["agenda", "calendar", "appointment", "contact", "address book",
        "organisation", "organizer", "organiser", "free/busy", "pdf", "document",
        "office", "spreadsheet", "presentation", "text and source", "mail client"]],
    ["System", ["backup", "restore", "firewall", "security", "virus", "posture",
        "process", "task manager", "package", "install", "upgrade", "verify",
        "remove", "lpm", "password", "vault", "secret", "encrypted", "settings",
        "appearance", "control center", "file manager", "files and folders"]],
    ["Utilities", ["calculator", "expression history", "help", "user guide",
        "about", "credits", "system information", "archive", "extract", "zip",
        "weather", "forecast", "widget", "update", "snapshot", "bug report",
        "crash", "launcher", "clock", "burn", "usb key"]]
]

let APPS_CONFIG = "lg3d-apps/src/config/"
let ETC_CONFIG = "lg3d-core/src/etc/"

// ---------------------------------------------------------------------------
// descriptor reading (the same shape startmenu-audit.mnd parses)
// ---------------------------------------------------------------------------

// The desktop scans config/demo and config/incubator on the classpath; in this
// repository that is the apps module's descriptors and the desktop's own etc/
// tree. Anything else in the tree is a file the desktop never reads, so its
// category label is a template, not a menu the user sees.
fun isLive(descriptorPath) {
    return descriptorPath.startsWith(APPS_CONFIG) ||
        descriptorPath.startsWith(ETC_CONFIG)
}

fun walk(dir, suffix, found) {
    for (name in fs.list(dir)) {
        if (name.startsWith(".") || name == "build" || name == "build-gradle") {
            continue
        }
        let path = if (dir == ".") name else "${dir}/${name}"
        if (fs.isDirectory(path)) {
            walk(path, suffix, found)
        } else if (name.endsWith(suffix)) {
            found.push(path)
        }
    }
    return found
}

// The text of one `<void property="x"> <string>value</string> </void>` block.
fun propertyOf(text, name) {
    let marker = "property=\"${name}\""
    if (!text.contains(marker)) { return "" }
    let rest = text.substring(text.indexOf(marker))
    let open = rest.indexOf("<string>")
    if (open < 0) { return "" }
    let body = rest.substring(open + 8)
    let close = body.indexOf("</string>")
    if (close < 0) { return "" }
    return body.substring(0, close).trim()
}

// How many of a category's keywords appear in the haystack, and which ones did.
fun scoreCategory(haystack, keywords) {
    var hits = []
    for (kw in keywords) {
        if (haystack.contains(kw)) { hits.push(kw) }
    }
    return hits
}

fun keywordsFor(group) {
    for (pair in CATEGORIES) {
        if (pair.get(0) == group) { return pair.get(1) }
    }
    return []
}

// ---------------------------------------------------------------------------
// the report
// ---------------------------------------------------------------------------

var reviews = []
var noGroup = 0
var noSignal = 0
var agree = 0
var items = 0

for (cfg in walk(".", ".lgcfg", [])) {
    if (!isLive(cfg)) { continue }
    var text = ""
    try { text = fs.read(cfg) } catch (e) { continue }   // never let one undecodable descriptor stop the read
    let label = propertyOf(text, "name")
    if (label.length == 0) { continue }                  // a group header or template, not an item
    items = items + 1
    let group = propertyOf(text, "menuGroup")
    let desc = propertyOf(text, "desc")
    if (group.length == 0) { noGroup = noGroup + 1; continue }   // an item that cannot disagree with nothing
    let haystack = "${label} ${desc}".lower()

    // The best-supported category across the vocabulary: highest keyword count,
    // first row wins a tie. The declared group's own score is the bar to beat,
    // so an item already in a well-supported category is never flagged.
    var bestCat = ""
    var bestHits = []
    for (pair in CATEGORIES) {
        let hits = scoreCategory(haystack, pair.get(1))
        if (hits.length > bestHits.length) {
            bestCat = pair.get(0)
            bestHits = hits
        }
    }
    if (bestHits.length == 0) { noSignal = noSignal + 1; continue }   // nothing to say about this item

    let declaredHits = scoreCategory(haystack, keywordsFor(group))
    if (bestCat != group && bestHits.length > declaredHits.length) {
        let shown = if (desc.length > 0) desc else label
        let matched = bestHits.join(", ")
        reviews.push("  ${group} -> ${bestCat}  '${label}'  reads: \"${shown}\"  matched: ${matched}  (${cfg})")
    } else {
        agree = agree + 1
    }
}

println("startmenu-categories: ${items} live item(s) read from ${APPS_CONFIG} and ${ETC_CONFIG}")
println("  ${agree} filed in the group their description supports")
println("  ${noSignal} carry no category keyword (a name too terse to judge)")
println("  ${noGroup} declare no menuGroup at all")

if (reviews.length == 0) {
    println("no item's category is contradicted by its own description")
} else {
    println("${reviews.length} item(s) whose description reads like a different group (review by hand):")
    for (r in reviews.sorted()) { println(r) }
}
