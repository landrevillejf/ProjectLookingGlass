<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  LG3D Checkstyle configuration.

  The 2006-era sources trip thousands of purely-cosmetic rules, so this config
  deliberately enables ONLY high-signal, bug-prone-pattern checks and omits
  formatting / whitespace / Javadoc / naming rules. Every module is clean under
  this set, so the root build.gradle enforces it at ZERO tolerance: the task
  runs with ignoreFailures=false AND maxWarnings=maxErrors=0. That maxWarnings=0
  is the load-bearing half -- the findings below are severity=warning and Gradle
  defaults maxWarnings to Integer.MAX_VALUE, so without it a warning still exits
  0 and "BUILD SUCCESSFUL" never means "0 violations". With it, any finding
  fails `check`, hence CI and the pull request; the XML+HTML report is still
  uploaded for review. Keep a new module clean before it lands, and never raise
  these thresholds to wave a violation through.

  Suppress a specific region with:
      //CHECKSTYLE:OFF
      ...legacy code...
      //CHECKSTYLE:ON
-->
<module name="Checker">
    <property name="severity" value="warning"/>
    <property name="fileExtensions" value="java"/>

    <module name="TreeWalker">
        <!-- Imports -->
        <module name="UnusedImports"/>
        <module name="RedundantImport"/>

        <!-- Bug-prone patterns -->
        <module name="CovariantEquals"/>
        <module name="EqualsHashCode"/>
        <module name="StringLiteralEquality"/>
        <module name="InnerAssignment"/>
        <module name="IllegalInstantiation"/>
        <module name="EmptyStatement"/>
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>

        <!-- switch correctness -->
        <module name="MissingSwitchDefault"/>
        <module name="DefaultComesLast"/>
        <module name="FallThrough"/>

        <!-- Structure -->
        <module name="PackageDeclaration"/>

        <!-- Region suppression -->
        <module name="SuppressionCommentFilter"/>
    </module>
</module>
