 <!-- Start Menu item: Algea3D (jmf23D, from lg3d-incubator). A JMF-backed 3D
 media player. Launched in-JVM via the "java <class>" command; the incubator jar
 and the bundled JMF jars in ext/ are on the :lg3d-core:run classpath. Discovery
 only scans config/demo and config/incubator, so, following the Image Studio /
 Widget Gallery precedent, this descriptor lives in lg3d-demo-apps/src/config
 (bundled to config/demo) rather than the incubator's own src/config. -->
 <object class="org.jdesktop.lg3d.scenemanager.utils.startmenu.StartMenuItemConfig">
  <void property="command">
   <string>java org.jdesktop.lg3d.apps.jmf23D.Algea3D</string>
  </void>
  <void property="desc">
   <string>3D media player</string>
  </void>
  <void property="displayResourceType">
   <string>ICON</string>
  </void>
  <void property="displayResourceUrlName">
   <string>resource:///resources/images/icon/defaultapp.png</string>
  </void>
  <void property="menuGroup">
   <string>Media</string>
  </void>
  <void property="name">
   <string>Algea3D</string>
  </void>
 </object>
