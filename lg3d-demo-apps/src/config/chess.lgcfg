<?xml version="1.0" encoding="UTF-8"?>
<java version="1.5.0" class="java.beans.XMLDecoder">
 <!-- Start Menu item: Chess 3D (from lg3d-incubator). A native 3D chess game
 with full rules (castling, en passant, promotion) and a negamax plus
 alpha-beta engine with quiescence search. Launched in-JVM via the
 "java <class>" command; the incubator jar is on the :lg3d-core:run classpath.
 Discovery only scans config/demo and config/incubator, so, following the
 Agenda 3D precedent, this descriptor lives in lg3d-demo-apps/src/config
 (bundled to config/demo). -->
 <object class="org.jdesktop.lg3d.scenemanager.utils.startmenu.StartMenuItemConfig">
  <void property="command">
   <string>java org.jdesktop.lg3d.apps.games.chess.Chess3D</string>
  </void>
  <void property="desc">
   <string>3D chess vs a search engine</string>
  </void>
  <void property="displayResourceType">
   <string>ICON</string>
  </void>
  <void property="displayResourceUrlName">
   <string>resource:///resources/images/icon/chess.png</string>
  </void>
  <void property="menuGroup">
   <string>Games</string>
  </void>
  <void property="name">
   <string>Chess 3D</string>
  </void>
 </object>
</java>
