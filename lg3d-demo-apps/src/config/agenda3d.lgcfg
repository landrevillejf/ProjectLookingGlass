<?xml version="1.0" encoding="UTF-8"?>
<java version="1.5.0" class="java.beans.XMLDecoder">
 <!-- Start Menu item: Agenda 3D (orgchart, from lg3d-incubator). A native 3D
 week agenda that reads the same shared /contacts store Contact 3D populates,
 so appointments can invite contacts and show their live free/busy presence.
 Launched in-JVM via the "java <class>" command; the incubator jar is on the
 :lg3d-core:run classpath. Discovery only scans config/demo and config/incubator,
 so, following the Contact 3D precedent, this descriptor lives in
 lg3d-demo-apps/src/config (bundled to config/demo) rather than the incubator's
 own src/config. -->
 <object class="org.jdesktop.lg3d.scenemanager.utils.startmenu.StartMenuItemConfig">
  <void property="command">
   <string>java org.jdesktop.lg3d.apps.orgchart.ui.agenda.Agenda3D</string>
  </void>
  <void property="desc">
   <string>3D week agenda</string>
  </void>
  <void property="displayResourceType">
   <string>ICON</string>
  </void>
  <void property="displayResourceUrlName">
   <string>resource:///resources/images/icon/agenda3d.png</string>
  </void>
  <void property="menuGroup">
   <string>Office</string>
  </void>
  <void property="name">
   <string>Agenda 3D</string>
  </void>
 </object>
</java>
