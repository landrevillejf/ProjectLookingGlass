<?xml version="1.0" encoding="UTF-8"?>
<java version="1.5.0" class="java.beans.XMLDecoder">
 <!-- Start Menu item: the photo viewer (from lg3d-apps). Launched in-JVM via
      the "java <class>" command; lives in the Media menu group. The panel is a
      tagged gallery that decodes images natively with ImageIO. The same
      PhotoViewerPanel serves the 2D/Swing desktop as an MDI internal frame via
      Desktop2DAppRegistry.PANEL_APPS. -->
 <object class="org.jdesktop.lg3d.scenemanager.utils.startmenu.StartMenuItemConfig">
  <void property="command">
   <string>java org.jdesktop.lg3d.apps.photoviewer.PhotoViewer</string>
  </void>
  <void property="desc">
   <string>Browse and tag your photo gallery</string>
  </void>
  <void property="displayResourceType">
   <string>ICON</string>
  </void>
  <void property="displayResourceUrlName">
   <string>resource:///resources/images/icon/photoviewer.png</string>
  </void>
  <void property="menuGroup">
   <string>Media</string>
  </void>
  <void property="name">
   <string>Photo Viewer</string>
  </void>
 </object>
</java>
