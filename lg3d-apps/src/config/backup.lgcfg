<?xml version="1.0" encoding="UTF-8"?>
<java version="1.5.0" class="java.beans.XMLDecoder">
 <!-- Start Menu item: the backup and restore tool (from lg3d-apps). Launched
      in-JVM via the "java <class>" command; lives in the System menu group. The
      same BackupPanel serves the 2D/Swing desktop as an MDI internal frame via
      Desktop2DAppRegistry.PANEL_APPS. -->
 <object class="org.jdesktop.lg3d.scenemanager.utils.startmenu.StartMenuItemConfig">
  <void property="command">
   <string>java org.jdesktop.lg3d.apps.backup.Backup</string>
  </void>
  <void property="desc">
   <string>Back up and restore files and folders</string>
  </void>
  <void property="displayResourceType">
   <string>ICON</string>
  </void>
  <void property="displayResourceUrlName">
   <string>resource:///resources/images/icon/backup.png</string>
  </void>
  <void property="menuGroup">
   <string>System</string>
  </void>
  <void property="name">
   <string>Backup</string>
  </void>
 </object>
</java>
