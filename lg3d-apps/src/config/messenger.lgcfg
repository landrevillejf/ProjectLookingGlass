<?xml version="1.0" encoding="UTF-8"?>
<java version="1.5.0" class="java.beans.XMLDecoder">
 <!-- Start Menu item: the multi-protocol instant messenger (from lg3d-apps).
      Launched in-JVM via the "java <class>" command; lives in the Internet
      menu group. The same MessengerPanel serves the 2D/Swing desktop as an MDI
      internal frame via Desktop2DAppRegistry.PANEL_APPS. -->
 <object class="org.jdesktop.lg3d.scenemanager.utils.startmenu.StartMenuItemConfig">
  <void property="command">
   <string>java org.jdesktop.lg3d.apps.messenger.Messenger</string>
  </void>
  <void property="desc">
   <string>Instant Messenger (IRC and more)</string>
  </void>
  <void property="displayResourceType">
   <string>ICON</string>
  </void>
  <void property="displayResourceUrlName">
   <string>resource:///resources/images/icon/messenger.png</string>
  </void>
  <void property="menuGroup">
   <string>Internet</string>
  </void>
  <void property="name">
   <string>Instant Messenger</string>
  </void>
 </object>
</java>
