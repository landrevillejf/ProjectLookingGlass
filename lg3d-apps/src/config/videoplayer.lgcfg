<?xml version="1.0" encoding="UTF-8"?>
<java version="1.5.0" class="java.beans.XMLDecoder">
 <!-- Start Menu item: the video player (from lg3d-apps). Launched in-JVM via
      the "java <class>" command; lives in the Media menu group. The panel is a
      VLC-style front-end that hands every file, stream or disc to a real
      external player. The same VideoPlayerPanel serves the 2D/Swing desktop as
      an MDI internal frame via Desktop2DAppRegistry.PANEL_APPS. -->
 <object class="org.jdesktop.lg3d.scenemanager.utils.startmenu.StartMenuItemConfig">
  <void property="command">
   <string>java org.jdesktop.lg3d.apps.videoplayer.VideoPlayer</string>
  </void>
  <void property="desc">
   <string>Play movies, streams and discs</string>
  </void>
  <void property="displayResourceType">
   <string>ICON</string>
  </void>
  <void property="displayResourceUrlName">
   <string>resource:///resources/images/icon/videoplayer.png</string>
  </void>
  <void property="menuGroup">
   <string>Media</string>
  </void>
  <void property="name">
   <string>Video Player</string>
  </void>
 </object>
</java>
