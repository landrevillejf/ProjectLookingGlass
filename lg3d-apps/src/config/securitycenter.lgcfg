<?xml version="1.0" encoding="UTF-8"?>
<java version="1.5.0" class="java.beans.XMLDecoder">
 <!-- Start Menu item: the Antivirus / Security Center (from lg3d-apps). Launched
 in-JVM via the "java <class>" command; lives in the System menu group. The same
 SecurityCenterPanel serves the 2D/Swing desktop as an MDI internal frame via
 Desktop2DAppRegistry.PANEL_APPS. Scanning is delegated to an installed ClamAV. -->
 <object class="org.jdesktop.lg3d.scenemanager.utils.startmenu.StartMenuItemConfig">
  <void property="command">
   <string>java org.jdesktop.lg3d.apps.securitycenter.SecurityCenter</string>
  </void>
  <void property="desc">
   <string>Scan for viruses and review the system security posture</string>
  </void>
  <void property="displayResourceType">
   <string>ICON</string>
  </void>
  <void property="displayResourceUrlName">
   <string>resource:///resources/images/icon/securitycenter.png</string>
  </void>
  <void property="menuGroup">
   <string>System</string>
  </void>
  <void property="name">
   <string>Security Center</string>
  </void>
 </object>
</java>
