<?xml version="1.0" encoding="UTF-8"?>
<java version="1.5.0" class="java.beans.XMLDecoder">
 <!-- Start Menu item: Wonderland World 3D (lg3d-apps,
 org.jdesktop.lg3d.apps.wonderland.WonderlandWorld3D). The 3D half of the
 Wonderland desktop integration: it builds the live world through
 wonderland-desktop's scene-graph bridge (install the renderer, hand the world to
 the scene manager as a Frame3D, connect the desktop's picked events to the
 cells) and opens the world HUD beside it, hosted on a SwingNode through
 TitledSwingWindow. Because a "java <class>" command runs its main IN the desktop
 JVM (AppLaunchAction), this is what makes the bridge reachable from a running
 desktop at all - before it, wonderland-desktop was built and tested but nothing
 ever asked for it. The command is 3D-only on purpose: Desktop2DAppRegistry does
 not list it, so the 2D/Swing desktop classifies it UNAVAILABLE and drops it from
 that menu rather than mounting a scene graph with no universe to hold it. The
 read-only inventory of the same world stays available there through
 wonderland.lgcfg. Needs the wonderland jars on the :lg3d-core:run classpath (see
 lg3d-core/build.gradle); the server the HUD reads comes from
 -Dlg.wonderland.server.url (default http://localhost:8080). Discovery only scans
 config/demo and config/incubator, so this descriptor lives in
 lg3d-apps/src/config (bundled to config/demo). The "Internet" menuGroup is
 declared in lg3d-core/src/etc/lg3d/startmenu.lgcfg. -->
 <object class="org.jdesktop.lg3d.scenemanager.utils.startmenu.StartMenuItemConfig">
  <void property="command">
   <string>java org.jdesktop.lg3d.apps.wonderland.WonderlandWorld3D</string>
  </void>
  <void property="desc">
   <string>Mount a Wonderland world in the 3D desktop</string>
  </void>
  <void property="displayResourceType">
   <string>ICON</string>
  </void>
  <void property="displayResourceUrlName">
   <string>resource:///resources/images/icon/wonderland3d.png</string>
  </void>
  <void property="menuGroup">
   <string>Internet</string>
  </void>
  <void property="name">
   <string>Wonderland World 3D</string>
  </void>
  <void property="version">
   <string>1.0.0</string>
  </void>
 </object>
</java>
