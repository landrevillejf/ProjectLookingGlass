  </void>
  <void property="displayResourceUrlName">
   <string>resource:///resources/images/icon/tictactoe.png</string>
  </void>
  <void property="menuGroup">
   <string>Games</string>
  </void>
  <void property="name">
   <string>Tic-Tac-Toe 3D</string>
  </void>
