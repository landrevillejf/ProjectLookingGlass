<?xml version="1.0" encoding="UTF-8"?>
<java version="1.5.0" class="java.beans.XMLDecoder">
 <!-- Start Menu item: Espresso (lg3d-apps, org.jdesktop.lg3d.apps.texteditor).
 The Advanced Text Editor, branded Espresso: a production plain-text and
 source-code editor with
 multi-tab editing, syntax highlighting for 16 languages, regex find and
 replace with live match counts, safe atomic file IO, line-number gutter,
 smart indent, light and dark themes, persisted settings and recent files, and
 a TextEditorExtension SPI (bundled Text Tools). The one panel serves both
 desktops - in 3D the AdvancedTextEditor wrapper hosts it on a SwingNode
 inside a Frame3D via TitledSwingWindow; in the 2D/Swing desktop
 Desktop2DAppRegistry.PANEL_APPS opens the same panel as an MDI internal
 frame. Launched in-JVM via the "java <class>" command; the lg3d-apps jar is
 on the :lg3d-core:run classpath. Discovery only scans config/demo and
 config/incubator, so this descriptor lives in lg3d-apps/src/config (bundled
 to config/demo). The "Office" menuGroup is declared in
 lg3d-core/src/etc/lg3d/startmenu.lgcfg. -->
 <object class="org.jdesktop.lg3d.scenemanager.utils.startmenu.StartMenuItemConfig">
  <void property="command">
   <string>java org.jdesktop.lg3d.apps.texteditor.AdvancedTextEditor</string>
  </void>
  <void property="desc">
   <string>Espresso: edit text and source files with highlighting and find/replace</string>
  </void>
  <void property="displayResourceType">
   <string>ICON</string>
  </void>
  <void property="displayResourceUrlName">
   <string>resource:///resources/images/icon/text-editor.png</string>
  </void>
  <void property="menuGroup">
   <string>Office</string>
  </void>
  <void property="name">
   <string>Espresso</string>
  </void>
 </object>
</java>
