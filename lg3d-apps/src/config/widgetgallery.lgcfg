<?xml version="1.0" encoding="UTF-8"?>
<java version="1.5.0" class="java.beans.XMLDecoder">
 <!-- Start Menu item: the desktop widget gallery (from lg3d-widgets). The
 lg3d-widgets jar is on the :lg3d-core:run classpath, so the in-JVM
 "java <class>" launch resolves the gallery's main(). -->
 <object class="org.jdesktop.lg3d.scenemanager.utils.startmenu.StartMenuItemConfig">
  <void property="command">
   <string>java org.jdesktop.lg3d.widgets.gallery.WidgetGallery</string>
  </void>
  <void property="desc">
   <string>Add or remove desktop widgets</string>
  </void>
  <void property="displayResourceType">
   <string>ICON</string>
  </void>
  <void property="displayResourceUrlName">
   <string>resource:///resources/images/icon/star.png</string>
  </void>
  <void property="menuGroup">
   <string>Utilities</string>
  </void>
  <void property="name">
   <string>Widget Gallery</string>
  </void>
 </object>
</java>
