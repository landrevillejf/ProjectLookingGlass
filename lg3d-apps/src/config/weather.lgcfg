<?xml version="1.0" encoding="UTF-8"?>
<java version="1.5.0" class="java.beans.XMLDecoder">
 <!-- Start Menu item: Weather (lg3d-apps, org.jdesktop.lg3d.apps.weather). A
 production current-conditions + six-day forecast reader fed by the free
 Open-Meteo API (the same key-less source the desktop Weather widget uses) over
 the JDK java.net.http client with a dependency-free JSON reader - no
 third-party library. The one panel serves both desktops: in 3D the Weather
 wrapper hosts it on a SwingNode inside a Frame3D via TitledSwingWindow; in the
 2D/Swing desktop Desktop2DAppRegistry.PANEL_APPS opens the same panel as an MDI
 internal frame. Launched in-JVM via the "java <class>" command; the lg3d-apps
 jar is on the :lg3d-core:run classpath. Discovery only scans config/demo and
 config/incubator, so this descriptor lives in lg3d-apps/src/config (bundled to
 config/demo). The "Utilities" menuGroup is declared in
 lg3d-core/src/etc/lg3d/startmenu.lgcfg. -->
 <object class="org.jdesktop.lg3d.scenemanager.utils.startmenu.StartMenuItemConfig">
  <void property="command">
   <string>java org.jdesktop.lg3d.apps.weather.Weather</string>
  </void>
  <void property="desc">
   <string>Current conditions and forecast from Open-Meteo</string>
  </void>
  <void property="displayResourceType">
   <string>ICON</string>
  </void>
  <void property="displayResourceUrlName">
   <string>resource:///resources/images/icon/weather.png</string>
  </void>
  <void property="menuGroup">
   <string>Utilities</string>
  </void>
  <void property="name">
   <string>Weather</string>
  </void>
 </object>
</java>
