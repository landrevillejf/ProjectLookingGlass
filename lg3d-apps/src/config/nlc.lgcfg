<?xml version="1.0" encoding="UTF-8"?>
<java version="1.5.0" class="java.beans.XMLDecoder">
 <!-- Start Menu item: Natural Language Control (nlc, from lg3d-incubator). A
 voice/command-driven 3D mascot that launches apps from spoken or typed commands.
 Launched in-JVM via the "java <class>" command; the incubator jar is on the
 :lg3d-core:run classpath. Discovery only scans config/demo and config/incubator,
 so, following the Image Studio / Widget Gallery precedent, this descriptor lives
 in lg3d-apps/src/config (bundled to config/demo) rather than the
 incubator's own src/config. -->
 <object class="org.jdesktop.lg3d.scenemanager.utils.startmenu.StartMenuItemConfig">
  <void property="command">
   <string>java org.jdesktop.lg3d.apps.nlc.Main</string>
  </void>
  <void property="desc">
   <string>Natural Language Control</string>
  </void>
  <void property="displayResourceType">
   <string>ICON</string>
  </void>
  <void property="displayResourceUrlName">
   <string>resource:///resources/images/icon/nlc.png</string>
  </void>
  <void property="menuGroup">
   <string>Utilities</string>
  </void>
  <void property="name">
   <string>Natural Language Control</string>
  </void>
 </object>
</java>
