<?xml version="1.0" encoding="UTF-8"?>
<java version="1.5.0" class="java.beans.XMLDecoder">
 <!-- Start Menu item: the image editor (from lg3d-apps). Launched in-JVM via the
      "java <class>" command; lives in the Media menu group. A GIMP-style
      layer/tool/filter workspace built on plain Java 2D, a step up from the
      basic Paint app. The same ImageEditorPanel serves the 2D/Swing desktop as
      an MDI internal frame via Desktop2DAppRegistry.PANEL_APPS. -->
 <object class="org.jdesktop.lg3d.scenemanager.utils.startmenu.StartMenuItemConfig">
  <void property="command">
   <string>java org.jdesktop.lg3d.apps.imageeditor.ImageEditor</string>
  </void>
  <void property="desc">
   <string>Edit images with layers, tools and filters</string>
  </void>
  <void property="displayResourceType">
   <string>ICON</string>
  </void>
  <void property="displayResourceUrlName">
   <string>resource:///resources/images/icon/imageeditor.png</string>
  </void>
  <void property="menuGroup">
   <string>Media</string>
  </void>
  <void property="name">
   <string>Image Editor</string>
  </void>
 </object>
</java>
