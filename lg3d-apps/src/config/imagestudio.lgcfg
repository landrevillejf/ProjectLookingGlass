<?xml version="1.0" encoding="UTF-8"?>
<java version="1.5.0" class="java.beans.XMLDecoder">
 <!-- Start Menu item: Image Studio (from lg3d-incubator). Launched in-JVM via
 the "java <class>" command; the incubator jar and the bundled JAI jars are on
 the :lg3d-core:run classpath, so the app and javax.media.jai.* both resolve.
 Discovery only scans config/demo and config/incubator, so, following the
 Widget Gallery precedent, this descriptor lives in lg3d-apps/src/config
 (bundled to config/demo) rather than the incubator's own src/config. -->
 <object class="org.jdesktop.lg3d.scenemanager.utils.startmenu.StartMenuItemConfig">
  <void property="command">
   <string>java org.jdesktop.lg3d.apps.imagestudio.ImageStudioApp</string>
  </void>
  <void property="desc">
   <string>JAI image editor</string>
  </void>
  <void property="displayResourceType">
   <string>ICON</string>
  </void>
  <void property="displayResourceUrlName">
   <string>resource:///resources/images/icon/imagestudio.png</string>
  </void>
  <void property="menuGroup">
   <string>Utilities</string>
  </void>
  <void property="name">
   <string>Image Studio</string>
  </void>
 </object>
</java>
