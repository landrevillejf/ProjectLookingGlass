<?xml version="1.0" encoding="UTF-8"?>
<java version="1.5.0" class="java.beans.XMLDecoder">
 <!-- Start Menu item: the Password Manager (from lg3d-apps). Launched in-JVM via
 the "java <class>" command; lives in the System menu group beside the Security
 Center and Firewall. The same PasswordManagerPanel serves the 2D/Swing desktop as
 an MDI internal frame via Desktop2DAppRegistry.PANEL_APPS. Credentials are sealed
 in a master-password vault (PBKDF2 plus AES-GCM); only ciphertext is stored. -->
 <object class="org.jdesktop.lg3d.scenemanager.utils.startmenu.StartMenuItemConfig">
  <void property="command">
   <string>java org.jdesktop.lg3d.apps.passwordmanager.PasswordManager</string>
  </void>
  <void property="desc">
   <string>Store passwords and secrets in an encrypted, master-password-sealed vault</string>
  </void>
  <void property="displayResourceType">
   <string>ICON</string>
  </void>
  <void property="displayResourceUrlName">
   <string>resource:///resources/images/icon/passwordmanager.png</string>
  </void>
  <void property="menuGroup">
   <string>System</string>
  </void>
  <void property="name">
   <string>Password Manager</string>
  </void>
 </object>
</java>
