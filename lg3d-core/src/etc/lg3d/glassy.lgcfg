<?xml version="1.0" encoding="UTF-8"?>
<java version="1.5.0" class="java.beans.XMLDecoder">

 <!-- Advanced Scene manager and Taskbar-->
<!--
 <object class="org.jdesktop.lg3d.scenemanager.advanced.AdvancedSceneManagerConfig"/>
 <object class="org.jdesktop.lg3d.scenemanager.utils.plugin.SceneManagerPluginConfig">
  <void property="pluginClass">
   <string>org.jdesktop.lg3d.scenemanager.utils.taskbar.AdvancedGlassyTaskbar</string>
  </void>
  <void property="singletonPlugin">
   <boolean>true</boolean>
  </void>
 </object>
-->
 <!-- Glassy Scene manager and Taskbar -->
 <object class="org.jdesktop.lg3d.scenemanager.glassy.GlassySceneManagerConfig"/>
 <object class="org.jdesktop.lg3d.scenemanager.utils.plugin.SceneManagerPluginConfig">
  <void property="pluginClass">
   <string>org.jdesktop.lg3d.scenemanager.utils.taskbar.GlassyTaskbar</string>
  </void>
  <void property="singletonPlugin">
   <boolean>true</boolean>
  </void>
 </object>
 
 <!-- Start menu -->
 <object class="org.jdesktop.lg3d.scenemanager.utils.plugin.SceneManagerPluginConfig">
  <void property="pluginClass">
   <string>org.jdesktop.lg3d.scenemanager.utils.startmenu.StartMenu</string>
  </void>
  <void property="singletonPlugin">
   <boolean>true</boolean>
  </void>
 </object>

 <!-- Workaround for Issue 524 - do StartMenuConfig stuff here instead of in
 startmenu.lgcfg in order to get it processed before the TaskbarItemConfig 
 event StartMenu posts during its initialization -->
 <!-- Start menu properties -->
 <object class="org.jdesktop.lg3d.scenemanager.utils.startmenu.StartMenuConfig">
  <!-- Model class name -->
  <void property="menuModelClass">
   <string>org.jdesktop.lg3d.scenemanager.utils.startmenu.model.panel.PanelStartMenuModel</string>
   <!--<string>org.jdesktop.lg3d.scenemanager.utils.startmenu.model.disc.DiscStartMenuModel</string>-->
   <!--<string>org.jdesktop.lg3d.scenemanager.utils.startmenu.model.orbit.OrbitStartMenuModel</string>-->
  </void>
 </object>

 <!-- Desktop widget layer (clock/temperature/cpu/memory). From lg3d-widgets;
 its jar is on the :lg3d-core:run classpath. getPluginRoot() returns a
 screen-sized container placed in front of the background and behind apps. -->
 <object class="org.jdesktop.lg3d.scenemanager.utils.plugin.SceneManagerPluginConfig">
  <void property="pluginClass">
   <string>org.jdesktop.lg3d.widgets.host.WidgetLayerPlugin</string>
  </void>
  <void property="singletonPlugin">
   <boolean>true</boolean>
  </void>
 </object>

 <!-- Front-most desktop HUD layer (toasts, window switcher, run dialog, context
 menu, snap preview, workspace pager, brightness dim). From lg3d-core
 (scenemanager.utils.hud). getPluginRoot() returns a screen-sized container that
 floats IN FRONT of every application window - the non-taskbar integration surface
 for the overlay chrome ported from the 2D/Swing desktop. -->
 <object class="org.jdesktop.lg3d.scenemanager.utils.plugin.SceneManagerPluginConfig">
  <void property="pluginClass">
   <string>org.jdesktop.lg3d.scenemanager.utils.hud.DesktopHudPlugin</string>
  </void>
  <void property="singletonPlugin">
   <boolean>true</boolean>
  </void>
 </object>

 <!-- Notification toast stack, mounted on the front-most HUD layer above. From
 lg3d-widgets (widgets.hud). MUST be registered AFTER DesktopHudPlugin so its
 layer() is live at init. Native 3D counterpart of the 2D desktop's toast layer;
 getPluginRoot() returns null because the overlay is parented to the HUD layer. -->
 <object class="org.jdesktop.lg3d.scenemanager.utils.plugin.SceneManagerPluginConfig">
  <void property="pluginClass">
   <string>org.jdesktop.lg3d.widgets.hud.ToastOverlayPlugin</string>
  </void>
  <void property="singletonPlugin">
   <boolean>true</boolean>
  </void>
 </object>

 <!-- Multiple workspaces (virtual desktops) for the native 3D desktop: partitions
 the open Frame3D windows, shows/hides them per workspace and mounts a clickable
 pager in the top-left corner of the HUD layer above. From lg3d-core
 (scenemanager.utils.workspace). MUST be registered AFTER DesktopHudPlugin so its
 layer() is live at init; getPluginRoot() returns null because the pager is
 parented to the HUD layer. Keystrokes mirror the 2D desktop: Alt+Shift+Page
 Down/Page Up page, Alt+Shift+1..9 move the front window. -->
 <object class="org.jdesktop.lg3d.scenemanager.utils.plugin.SceneManagerPluginConfig">
  <void property="pluginClass">
   <string>org.jdesktop.lg3d.scenemanager.utils.workspace.WorkspacePlugin</string>
  </void>
  <void property="singletonPlugin">
   <boolean>true</boolean>
  </void>
 </object>

 <!-- Edge window snapping for the native 3D desktop: drag a Frame3D so its
 left/right/top edge reaches the matching screen edge and, on release, it fills
 that half (or the whole usable area at the top), with a translucent preview quad
 on the HUD layer above while dragging. From lg3d-core (scenemanager.utils.snap).
 MUST be registered AFTER DesktopHudPlugin so its layer() is live at init;
 getPluginRoot() returns null because the preview is parented to the HUD layer. -->
 <object class="org.jdesktop.lg3d.scenemanager.utils.plugin.SceneManagerPluginConfig">
  <void property="pluginClass">
   <string>org.jdesktop.lg3d.scenemanager.utils.snap.WindowSnapPlugin</string>
  </void>
  <void property="singletonPlugin">
   <boolean>true</boolean>
  </void>
 </object>

 <!-- Alt+Tab-style window switcher for the native 3D desktop: Ctrl+Alt+Tab steps
 through the open Frame3D windows in most-recently-used order (Ctrl+Alt+Shift+Tab
 steps back), showing a translucent card of window titles on the HUD layer above,
 and commits the highlighted window to front on a short idle timer. From lg3d-core
 (scenemanager.utils.switcher). MUST be registered AFTER DesktopHudPlugin so its
 layer() is live at init; getPluginRoot() returns null because the card is
 parented to the HUD layer. Shares the pure WindowCycler MRU model with the 2D
 desktop. -->
 <object class="org.jdesktop.lg3d.scenemanager.utils.plugin.SceneManagerPluginConfig">
  <void property="pluginClass">
   <string>org.jdesktop.lg3d.scenemanager.utils.switcher.WindowSwitcherPlugin</string>
  </void>
  <void property="singletonPlugin">
   <boolean>true</boolean>
  </void>
 </object>

 <!-- Global keyboard shortcuts + Alt+F2 run dialog for the native 3D desktop:
 Alt+F2 raises a translucent "run command" card on the HUD layer that resolves a
 typed application name or external command (reusing the 2D desktop's RunResolver
 and persisted RunHistory) and launches it through AppLaunchAction; Ctrl+Alt+T
 opens a terminal. From lg3d-core (scenemanager.utils.run). MUST be registered
 AFTER DesktopHudPlugin so its layer() is live at init; getPluginRoot() returns
 null because the card is parented to the HUD layer. Claims only the run-dialog
 and open-terminal bindings from the shared ShortcutMap; the snap and workspace
 bindings stay with WindowSnapPlugin and WorkspacePlugin. -->
 <object class="org.jdesktop.lg3d.scenemanager.utils.plugin.SceneManagerPluginConfig">
  <void property="pluginClass">
   <string>org.jdesktop.lg3d.scenemanager.utils.run.RunDialogPlugin</string>
  </void>
  <void property="singletonPlugin">
   <boolean>true</boolean>
  </void>
 </object>

 <!-- Documents + Downloads folder stacks on the taskbar's right side,
 immediately before Exit. From lg3d-core (scenemanager.utils.taskbar.stack). -->
 <object class="org.jdesktop.lg3d.scenemanager.utils.plugin.SceneManagerPluginConfig">
  <void property="pluginClass">
   <string>org.jdesktop.lg3d.scenemanager.utils.taskbar.stack.StacksPlugin</string>
  </void>
  <void property="singletonPlugin">
   <boolean>true</boolean>
  </void>
 </object>

